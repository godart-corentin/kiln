def layout(title, body, refresh=None):
    refresh_html = f'<meta http-equiv="refresh" content="{int(refresh)}">' if refresh else ""
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{refresh_html}
<title>{esc(title)} · Kiln</title><style>{CSS}</style></head>
<body><main class="shell"><div class="topbar"><a class="brand" href="/"><span>◆</span> Kiln</a><span class="muted">CI</span></div>{body}</main></body></html>"""


def render_home():
    rows = []
    for build_dir, status in load_builds():
        state = status.get("state", "unknown")
        symbol, label, klass = state_label(state)
        build_id = status.get("build_id", build_dir.name)
        rows.append(f"""
<a class="build-row" href="/build/{quote(build_id, safe='')}">
<div><div class="project">{esc(status.get('project','?'))}</div><div class="muted">{esc(short_ref(status.get('ref','?')))} · <span class="sha">{esc(str(status.get('sha',''))[:7])}</span></div></div>
<div class="branch muted">{esc(status.get('type','?'))}</div><div><span class="badge {klass}">{symbol} {esc(label)}</span></div><div class="duration muted">{esc(duration(status.get('duration_seconds')))}</div>
</a>""")
    body = '<div class="hero"><div><h1>Builds</h1><div class="muted">Latest Kiln activity</div></div></div>'
    body += '<section class="panel">' + "".join(rows) + "</section>" if rows else '<section class="panel empty">No builds yet.</section>'
    return layout("Builds", body, refresh=10)


def render_build(build_dir, status):
    build_id = status["build_id"]
    state = status.get("state", "unknown")
    symbol, label, klass = state_label(state)
    steps_html = []
    for step_id, step in status.get("steps", {}).items():
        ssymbol, slabel, sklass = state_label(step.get("state", "unknown"))
        log_html = "—"
        log_name = step.get("log")
        if isinstance(log_name, str) and (build_dir / log_name).is_file():
            log_html = f'<a class="log-link" href="/build/{quote(build_id,safe="")}/logs/{quote(step_id,safe="")}">view log</a>'
        steps_html.append(f"""<div class="step"><div class="stage muted">{esc(step.get('stage','—'))}</div><div class="step-name">{esc(step_id)}</div><div><span class="badge {sklass}">{ssymbol} {esc(slabel)}</span></div><div class="duration">{log_html}</div></div>""")

    pipeline_log = build_dir / "logs" / "pipeline.log"
    extra_logs = f'<p><a class="log-link" href="/build/{quote(build_id,safe="")}/logs/pipeline">View pipeline log</a></p>' if pipeline_log.is_file() else ""

    artifact_html = [
        f'<div class="artifact"><span>{esc(name)}</span><span class="muted">{size:,} bytes</span></div>'
        for name, size in artifact_list(build_dir)
    ]
    body = f"""
<a class="back" href="/">← All builds</a>
<div class="hero"><div><h1>{esc(status.get('project','?'))}</h1><div class="meta"><span>{esc(short_ref(status.get('ref','?')))}</span><span class="sha">{esc(status.get('sha',''))}</span><span>{esc(status.get('type','?'))}</span></div></div><span class="badge {klass}">{symbol} {esc(label)}</span></div>
<div class="meta"><span>Duration: {esc(duration(status.get('duration_seconds')))}</span><span>Started: {esc(format_time(status.get('started_at')))}</span></div>
<h2>Steps</h2><section class="panel">{''.join(steps_html) if steps_html else '<div class="empty">No steps.</div>'}</section>{extra_logs}
<h2>Artifacts</h2><section class="panel">{''.join(artifact_html) if artifact_html else '<div class="empty">No artifacts.</div>'}</section>
"""
    return layout(
        f"{status.get('project','?')} · {str(status.get('sha',''))[:7]}",
        body,
        refresh=3 if state not in FINAL_STATES else None,
    )


def render_log(build_dir, status, log_name):
    if not LOG_RE.fullmatch(log_name):
        return None
    path = build_dir / "logs" / f"{log_name}.log"
    if not path.is_file():
        return None
    try:
        text, truncated = read_log_tail(path)
    except OSError:
        return None
    notice = '<div class="notice">Showing the last 2 MiB. Use the Kiln CLI for the complete log.</div>' if truncated else ""
    step = status.get("steps", {}).get(log_name)
    if step is not None:
        active = step.get("state") not in {"success", "failed", "skipped", "aborted"}
    elif log_name == "pipeline":
        active = status.get("state") not in FINAL_STATES
    else:
        active = False
    body = f"""<a class="back" href="/build/{quote(status['build_id'],safe='')}">← Build</a><div class="hero"><div><h1>{esc(log_name)}</h1><div class="muted">{esc(status.get('project','?'))} · {esc(str(status.get('sha',''))[:7])}</div></div></div>{notice}<section class="panel"><pre>{esc(text)}</pre></section>"""
    return layout(f"{log_name} · {str(status.get('sha',''))[:7]}", body, refresh=2 if active else None)


class KilnHandler(BaseHTTPRequestHandler):
    server_version = "KilnWeb/1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def send_page(self, code, content):
        data = content.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        )
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def error_page(self, code, message):
        self.send_page(code, layout(str(code), f'<section class="panel empty">{esc(message)}</section>'))

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        path = unquote(urlsplit(self.path).path)
        if path == "/healthz":
            data = b"ok\n"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)
            return

        if path == "/":
            self.send_page(200, render_home())
            return

        parts = [part for part in path.split("/") if part]
        if len(parts) >= 2 and parts[0] == "build":
            result = get_build(parts[1])
            if result is None:
                self.error_page(404, "Build not found.")
                return
            build_dir, status = result
            if len(parts) == 2:
                self.send_page(200, render_build(build_dir, status))
                return
            if len(parts) == 4 and parts[2] == "logs":
                page = render_log(build_dir, status, parts[3])
                if page is None:
                    self.error_page(404, "Log not found.")
                    return
                self.send_page(200, page)
                return
        self.error_page(404, "Not found.")

    def do_POST(self):
        self.error_page(405, "Kiln Web is read-only.")

    do_PUT = do_POST
    do_PATCH = do_POST
    do_DELETE = do_POST


def main():
    if os.geteuid() == 0:
        print("kiln web: refusing to run as root", file=sys.stderr)
        return 1

    server = ThreadingHTTPServer((HOST, PORT), KilnHandler)
    server.daemon_threads = True
    print(f"kiln web: listening on http://{HOST}:{PORT}", flush=True)
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
