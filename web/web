import html
import json
import os
import re
import stat
import sys
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import quote, unquote, urlsplit

BUILDS = Path("/var/lib/kiln/builds")
HOST = os.environ.get("KILN_WEB_HOST", "127.0.0.1")
PORT = int(os.environ.get("KILN_WEB_PORT", "8088"))

BUILD_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
LOG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
FINAL_STATES = {"success", "failed", "aborted"}
ANSI_RE = re.compile(r"\x1B(?:\[[0-?]*[ -/]*[@-~]|\].*?(?:\x07|\x1B\\))", re.DOTALL)
CONTROL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
MAX_LOG_BYTES = 2 * 1024 * 1024
MAX_BUILDS = 100
MAX_ARTIFACTS = 200


def esc(value):
    return html.escape(str(value), quote=True)


def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def sanitize_log(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return CONTROL_RE.sub("", ANSI_RE.sub("", text))


def read_log_tail(path):
    with path.open("rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        start = max(0, size - MAX_LOG_BYTES)
        f.seek(start)
        data = f.read()
    truncated = start > 0
    if truncated:
        parts = data.split(b"\n", 1)
        if len(parts) == 2:
            data = parts[1]
    return sanitize_log(data.decode("utf-8", errors="replace")), truncated


def short_ref(ref):
    for prefix in ("refs/heads/", "refs/tags/"):
        if ref.startswith(prefix):
            return ref[len(prefix):]
    return ref


def duration(value):
    if not isinstance(value, (int, float)):
        return "—"
    seconds = int(round(value))
    minutes, seconds = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h {minutes:02d}m {seconds:02d}s"
    if minutes:
        return f"{minutes}m {seconds:02d}s"
    return f"{seconds}s"


def format_time(value):
    if not value:
        return "—"
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
    except Exception:
        return value


def state_label(state):
    labels = {
        "success": ("✓", "Success", "success"),
        "failed": ("×", "Failed", "failed"),
        "aborted": ("!", "Aborted", "aborted"),
        "running": ("●", "Running", "running"),
        "preparing": ("●", "Preparing", "running"),
        "queued": ("•", "Queued", "pending"),
        "pending": ("•", "Pending", "pending"),
        "skipped": ("»", "Skipped", "skipped"),
    }
    return labels.get(state, ("?", state, "pending"))


def build_dirs():
    try:
        dirs = [path for path in BUILDS.iterdir() if path.is_dir()]
    except FileNotFoundError:
        return []
    return sorted(dirs, key=lambda path: path.name, reverse=True)[:MAX_BUILDS]


def load_builds():
    result = []
    for build_dir in build_dirs():
        try:
            status = read_json(build_dir / "status.json")
            result.append((build_dir, status))
        except Exception:
            continue
    return result


def get_build(build_id):
    if not BUILD_RE.fullmatch(build_id):
        return None
    path = BUILDS / build_id
    if not path.is_dir():
        return None
    try:
        status = read_json(path / "status.json")
    except Exception:
        return None
    if status.get("build_id") != build_id:
        return None
    return path, status


def artifact_list(build_dir):
    root = build_dir / "artifacts"
    if not root.is_dir():
        return []
    items = []
    try:
        for path in sorted(root.rglob("*")):
            if len(items) >= MAX_ARTIFACTS:
                break
            try:
                info = path.lstat()
            except OSError:
                continue
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
                continue
            try:
                relative = path.relative_to(root)
            except ValueError:
                continue
            items.append((str(relative), info.st_size))
    except OSError:
        pass
    return items


