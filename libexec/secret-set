#!/usr/bin/env python3
import grp
import importlib.util
import os
import sys
from pathlib import Path

SECRETS_ROOT = Path("/etc/kiln/secrets")
CONFIG_ROOT = Path("/etc/kiln/projects")
MODULE = Path(__file__).resolve().with_name("secrets.py")
spec = importlib.util.spec_from_file_location("kiln_secrets", MODULE)
if spec is None or spec.loader is None:
    raise RuntimeError("cannot load secrets module")
secrets = importlib.util.module_from_spec(spec)
spec.loader.exec_module(secrets)


def fail(message):
    print(f"kiln secret set: {message}", file=sys.stderr)
    raise SystemExit(1)


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 3:
        fail("usage: secret-set <project> <name>")
    project, name = sys.argv[1:]
    if not (CONFIG_ROOT / f"{project}.json").is_file():
        fail(f"project does not exist: {project}")
    data = sys.stdin.buffer.read(1024 * 1024 + 1)
    if len(data) > 1024 * 1024:
        fail("secret is too large")
    try:
        secrets.store_secret(
            SECRETS_ROOT,
            project,
            name,
            data,
            kind="text",
            scope="release",
            uid=0,
            gid=grp.getgrnam("kiln").gr_gid,
        )
    except secrets.SecretError as exc:
        fail(str(exc))
    print(f"Secret {name} configured for {project} (release)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
