#!/usr/bin/env bash
set -Eeuo pipefail

GIT_ROOT="/srv/git"
CONFIG_ROOT="/etc/kiln/projects"
SECRETS_ROOT="/etc/kiln/secrets"
DEFAULTS="/etc/kiln/defaults.json"
HOOK_SOURCE="/usr/local/libexec/kiln/git-hooks/post-receive"

die() {
    echo "kiln project create: $*" >&2
    exit 1
}

[[ "${EUID}" -eq 0 ]] || die "must run as root"
[[ "$#" -eq 1 ]] || die "usage: project-create <project-name>"

project="$1"
[[ "$project" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] \
    || die "invalid project name: '$project'"

repo="${GIT_ROOT}/${project}.git"
config="${CONFIG_ROOT}/${project}.json"
secret="${SECRETS_ROOT}/${project}.discord-webhook"
secret_dir="${SECRETS_ROOT}/${project}"

getent passwd git >/dev/null || die "Linux user 'git' does not exist"
getent passwd kiln >/dev/null || die "Linux user 'kiln' does not exist"
command -v git >/dev/null || die "git is not installed"
command -v runuser >/dev/null || die "runuser is unavailable"
command -v setfacl >/dev/null || die "setfacl is unavailable (install package acl)"
[[ -d "$GIT_ROOT" ]] || die "$GIT_ROOT does not exist"
[[ -d "$CONFIG_ROOT" ]] || die "$CONFIG_ROOT does not exist"
[[ -d "$SECRETS_ROOT" ]] || die "$SECRETS_ROOT does not exist"
[[ -f "$DEFAULTS" ]] || die "$DEFAULTS does not exist"
[[ -f "$HOOK_SOURCE" && -x "$HOOK_SOURCE" ]] || die "Kiln post-receive hook is missing"
[[ "$(stat -c '%U:%G' "$HOOK_SOURCE")" == "root:root" ]] \
    || die "Kiln post-receive hook must be root:root"

if find "$HOOK_SOURCE" -perm /022 -print -quit | grep -q .; then
    die "Kiln post-receive hook must not be writable by group/others"
fi

[[ ! -e "$repo" ]] || die "repository already exists: $repo"
[[ ! -e "$config" ]] || die "project configuration already exists: $config"
[[ ! -e "$secret" ]] || die "Discord secret already exists: $secret"
[[ ! -e "$secret_dir" ]] || die "project secret directory already exists: $secret_dir"

created_repo=0
created_config=0
created_secret=0
created_secret_dir=0
tmp_config=""

cleanup_on_error() {
    rc=$?
    if [[ "$rc" -ne 0 ]]; then
        echo "kiln project create: creation failed; cleaning partial state" >&2
        [[ -n "$tmp_config" ]] && rm -f -- "$tmp_config"
        [[ "$created_config" -eq 1 ]] && rm -f -- "$config"
        [[ "$created_secret" -eq 1 ]] && rm -f -- "$secret"
        [[ "$created_secret_dir" -eq 1 ]] && rm -rf -- "$secret_dir"
        [[ "$created_repo" -eq 1 ]] && rm -rf -- "$repo"
    fi
    exit "$rc"
}
trap cleanup_on_error EXIT

echo "Creating Kiln project: $project"

install -d -o git -g git -m 0750 "$repo"
created_repo=1

runuser -u git -- env GIT_CONFIG_NOSYSTEM=1 \
    git init --bare --initial-branch=main "$repo" >/dev/null

runuser -u git -- git --git-dir="$repo" config transfer.hideRefs refs/kiln/
runuser -u git -- git --git-dir="$repo" config gc.packRefs false

# Read-only repository access for the controller.
setfacl -R -m u:kiln:rX "$repo"
find "$repo" -type d -exec setfacl -m d:u:kiln:r-x {} +

# The only Git namespace writable by kiln.
install -d -o git -g git -m 0750 "$repo/refs/kiln" "$repo/refs/kiln/jobs"
setfacl -m u:kiln:rwx,d:u:kiln:rwx "$repo/refs/kiln" "$repo/refs/kiln/jobs"

ln -s "$HOOK_SOURCE" "$repo/hooks/post-receive"

tmp_config="$(mktemp "${CONFIG_ROOT}/.${project}.XXXXXX")"
/usr/bin/python3 - "$project" "$repo" "$secret" "$DEFAULTS" >"$tmp_config" <<'PY'
import json
import sys
from pathlib import Path

project, repo, secret, defaults_path = sys.argv[1:]
defaults = json.loads(Path(defaults_path).read_text(encoding="utf-8"))
runner = defaults.get("runner")
if not isinstance(runner, dict):
    raise SystemExit("invalid /etc/kiln/defaults.json: runner missing")

config = {
    "schema": 1,
    "project": project,
    "repository": repo,
    "release": {"tag_pattern": r"^v[0-9]+\.[0-9]+\.[0-9]+$"},
    "runner": runner,
    "discord": {"webhook_file": secret},
}
print(json.dumps(config, indent=2))
PY

chown root:root "$tmp_config"
chmod 0644 "$tmp_config"
mv -- "$tmp_config" "$config"
tmp_config=""
created_config=1

install -d -o root -g kiln -m 0750 "$secret_dir"
created_secret_dir=1
install -o root -g kiln -m 0640 /dev/null "$secret"
created_secret=1

[[ "$(runuser -u git -- git --git-dir="$repo" rev-parse --is-bare-repository)" == "true" ]] \
    || die "bare repository validation failed"
[[ "$(runuser -u git -- git --git-dir="$repo" config --get transfer.hideRefs)" == "refs/kiln/" ]] \
    || die "transfer.hideRefs validation failed"
[[ "$(runuser -u git -- git --git-dir="$repo" config --get gc.packRefs)" == "false" ]] \
    || die "gc.packRefs validation failed"
[[ "$(readlink -f "$repo/hooks/post-receive")" == "$HOOK_SOURCE" ]] \
    || die "post-receive hook validation failed"

if runuser -u kiln -- test -w "$repo/refs/heads"; then
    die "security check failed: kiln can write refs/heads"
fi
runuser -u kiln -- test -w "$repo/refs/kiln/jobs" \
    || die "security check failed: kiln cannot write refs/kiln/jobs"

trap - EXIT

server="$(hostname -f 2>/dev/null || hostname)"
echo
echo "Created:"
echo "  repository: $repo"
echo "  config:     $config"
echo "  secret:     $secret"
echo "  secrets:    $secret_dir"
echo "  hook:       $repo/hooks/post-receive"
echo
echo "Development machine:"
echo "  git remote add home git@${server}:${repo}"
echo "  git push home main"
echo
echo "Optional Discord webhook:"
echo "  kiln project webhook set ${project}"
