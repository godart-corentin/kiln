#!/usr/bin/env python3
import grp
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlparse

CONFIG_ROOT = Path("/etc/kilnr/projects")
SECRETS_ROOT = Path("/etc/kilnr/secrets")
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
WEBHOOK_PATH_RE = re.compile(r"^/api/webhooks/[0-9]+/[^/\s]+/?$")
ALLOWED_HOSTS = {
    "discord.com",
    "canary.discord.com",
    "ptb.discord.com",
    "discordapp.com",
}


def fail(message: str) -> None:
    print(f"kilnr project webhook: {message}", file=sys.stderr)
    sys.exit(1)


def main() -> int:
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2:
        fail("usage: project-webhook-set <project-name>")

    project = sys.argv[1]
    if not PROJECT_RE.fullmatch(project):
        fail(f"invalid project name: {project!r}")

    config_path = CONFIG_ROOT / f"{project}.json"
    if not config_path.is_file():
        fail(f"project does not exist: {project}")

    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"invalid project configuration: {exc}")

    expected_secret = SECRETS_ROOT / f"{project}.discord-webhook"
    if config.get("schema") != 1 or config.get("project") != project:
        fail("project configuration mismatch")
    if config.get("discord", {}).get("webhook_file") != str(expected_secret):
        fail("unexpected webhook_file in project configuration")

    webhook = sys.stdin.read(8193).strip()
    if not webhook:
        fail("empty Discord webhook")
    if len(webhook) > 8192:
        fail("Discord webhook is too long")

    parsed = urlparse(webhook)
    if parsed.scheme != "https":
        fail("Discord webhook must use HTTPS")
    if parsed.hostname not in ALLOWED_HOSTS:
        fail("unexpected Discord webhook hostname")
    if parsed.username or parsed.password or parsed.port:
        fail("invalid Discord webhook URL")
    if not WEBHOOK_PATH_RE.fullmatch(parsed.path):
        fail("invalid Discord webhook path")
    if parsed.query or parsed.fragment:
        fail("Discord webhook must not contain query or fragment")

    kilnr_gid = grp.getgrnam("kilnr").gr_gid
    tmp_path = None
    try:
        fd, tmp_name = tempfile.mkstemp(
            prefix=f".{project}.discord-webhook.",
            dir=SECRETS_ROOT,
        )
        tmp_path = Path(tmp_name)
        os.fchmod(fd, 0o640)
        os.fchown(fd, 0, kilnr_gid)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(webhook + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, expected_secret)
        tmp_path = None
        dir_fd = os.open(SECRETS_ROOT, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    finally:
        if tmp_path is not None:
            tmp_path.unlink(missing_ok=True)

    print(f"Discord webhook configured for {project}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
