#!/usr/bin/env bash
set -u

hook_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null)" || {
    echo "kilnr: cannot resolve managed post-receive hook" >&2
    exit 0
}
libexec_root="$(dirname -- "$(dirname -- "$hook_path")")"
ENQUEUE="${libexec_root}/enqueue"
if [[ ! -x "$ENQUEUE" ]]; then
    echo "kilnr: managed enqueue helper is missing: $ENQUEUE" >&2
    exit 0
fi

while read -r old_sha new_sha ref
do
    [[ -n "$old_sha" ]] || continue
    [[ -n "$new_sha" ]] || continue
    [[ -n "$ref" ]] || continue

    output="$(
        "$ENQUEUE" \
            --receive \
            "$old_sha" \
            "$new_sha" \
            "$ref" \
            2>&1
    )"
    rc=$?

    if [[ "$rc" -ne 0 ]]; then
        echo "kilnr: enqueue failed for $ref" >&2
        [[ -n "$output" ]] && echo "$output" >&2
        continue
    fi

    [[ -n "$output" ]] && echo "kilnr: queued $output" >&2
done

exit 0
