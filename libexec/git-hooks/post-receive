#!/usr/bin/env bash
set -u

ENQUEUE="/usr/local/libexec/kiln/enqueue"

repo="$(
    /usr/bin/git rev-parse --absolute-git-dir 2>/dev/null
)" || {
    echo "kiln: cannot determine repository" >&2
    exit 0
}

repo_name="$(basename -- "$repo")"
project="${repo_name%.git}"

if [[ ! "$project" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
    echo "kiln: invalid repository/project name: $project" >&2
    exit 0
fi

while read -r old_sha new_sha ref
do
    [[ -n "$old_sha" ]] || continue
    [[ -n "$new_sha" ]] || continue
    [[ -n "$ref" ]] || continue

    output="$(
        "$ENQUEUE" \
            "$project" \
            "$old_sha" \
            "$new_sha" \
            "$ref" \
            2>&1
    )"
    rc=$?

    if [[ "$rc" -ne 0 ]]; then
        echo "kiln: enqueue failed for $ref" >&2
        [[ -n "$output" ]] && echo "$output" >&2
        continue
    fi

    [[ -n "$output" ]] && echo "kiln: queued $output" >&2
done

exit 0
