#!/usr/bin/env python3
import fcntl
import importlib.util
import json
import os
import pwd
import re
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath

CONFIG_ROOT = Path("/etc/kiln/projects")
INCOMING = Path("/var/lib/kiln/queue/incoming")
RUNNING = Path("/var/lib/kiln/queue/running")
BUILDS = Path("/var/lib/kiln/builds")
LOCK_FILE = Path("/var/lib/kiln/locks/controller.lock")

CI_PIPELINE_ROOT = ".kiln/pipelines"
RELEASE_PIPELINE = ".kiln/release.json"
MAX_PIPELINES = 64
MAX_PIPELINE_BYTES = 256 * 1024

PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
JOB_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
BUILD_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
OID_RE = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")

PIPELINE_MODULE_PATH = Path(__file__).resolve().with_name("pipeline.py")
_PIPELINE_SPEC = importlib.util.spec_from_file_location("kiln_pipeline_schema", PIPELINE_MODULE_PATH)
if _PIPELINE_SPEC is None or _PIPELINE_SPEC.loader is None:
    raise RuntimeError(f"cannot load pipeline module: {PIPELINE_MODULE_PATH}")
pipeline_schema = importlib.util.module_from_spec(_PIPELINE_SPEC)
_PIPELINE_SPEC.loader.exec_module(pipeline_schema)


class KilnError(Exception):
    pass


def fail(message):
    raise KilnError(message)


def now():
    return datetime.now(timezone.utc)


def iso(value=None):
    return (value or now()).isoformat().replace("+00:00", "Z")


def elapsed(started_at):
    start = datetime.fromisoformat(started_at.replace("Z", "+00:00"))
    return round((now() - start).total_seconds(), 3)


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"file not found: {path}")
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON {path}: {exc}")


def write_json(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with tmp.open("x", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        dfd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    finally:
        tmp.unlink(missing_ok=True)


def git(repo, *args):
    return subprocess.run(
        ["/usr/bin/git", f"--git-dir={repo}", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def validate_repo_path(path):
    if not isinstance(path, str):
        fail("pipeline path must be a string")
    pp = PurePosixPath(path)
    if pp.is_absolute() or ".." in pp.parts:
        fail(f"unsafe pipeline path: {path}")
    if not path.endswith(".json"):
        fail(f"pipeline path must end in .json: {path}")


def validate_job(job, filename):
    required = {
        "schema", "id", "project", "received_at", "old_sha", "new_sha",
        "sha", "ref", "type", "pin_ref",
    }
    missing = required - job.keys()
    if missing:
        fail("job missing: " + ", ".join(sorted(missing)))
    if job["schema"] != 1:
        fail("unsupported job schema")
    if not BUILD_RE.fullmatch(str(job["id"])):
        fail("invalid job id")
    if filename != f"{job['id']}.json":
        fail("job id/filename mismatch")
    if not PROJECT_RE.fullmatch(str(job["project"])):
        fail("invalid project")
    if job["type"] not in ("ci", "release"):
        fail("invalid job type")
    if not OID_RE.fullmatch(str(job["sha"])):
        fail("invalid job sha")
    if job["pin_ref"] != "refs/kiln/jobs/" + job["id"]:
        fail("invalid pin ref")

    event = job.get("event")
    if event is not None and event not in ("push", "pull_request", "tag"):
        fail("invalid job event")

    if job["type"] == "ci":
        branch = job_branch(job)
        if not isinstance(branch, str) or not branch or len(branch) > 255 or "\x00" in branch:
            fail("invalid CI branch")


def load_config(project):
    path = CONFIG_ROOT / f"{project}.json"
    cfg = read_json(path)
    expected_repo = Path("/srv/git") / f"{project}.git"
    if cfg.get("schema") != 1 or cfg.get("project") != project:
        fail(f"invalid project config: {path}")
    if Path(cfg.get("repository", "")) != expected_repo:
        fail(f"repository must be {expected_repo}")
    if not expected_repo.is_dir():
        fail(f"repository missing: {expected_repo}")

    release = cfg.get("release")
    if not isinstance(release, dict) or not isinstance(release.get("tag_pattern"), str):
        fail("release.tag_pattern is missing or invalid")

    runner = cfg.get("runner")
    if not isinstance(runner, dict):
        fail("runner config missing")
    if not isinstance(runner.get("max_parallel"), int) or not 1 <= runner["max_parallel"] <= 32:
        fail("runner.max_parallel invalid")
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", str(runner.get("cpus", ""))):
        fail("runner.cpus invalid")
    if not re.fullmatch(r"[0-9]+[kKmMgG]", str(runner.get("memory", ""))):
        fail("runner.memory invalid")
    if not isinstance(runner.get("pids_limit"), int) or not 16 <= runner["pids_limit"] <= 65535:
        fail("runner.pids_limit invalid")
    if not isinstance(runner.get("timeout_seconds"), int) or not 1 <= runner["timeout_seconds"] <= 86400:
        fail("runner.timeout_seconds invalid")
    networks = runner.get("allowed_networks")
    if (
        not isinstance(networks, list)
        or not networks
        or any(network not in ("none", "kiln-ci") for network in networks)
    ):
        fail("runner.allowed_networks invalid")
    return cfg


def extract_snapshot(job, cfg, build_dir):
    repo = Path(cfg["repository"])
    archive = build_dir / ".source.tar"
    src = build_dir / "src"
    log_path = build_dir / "logs" / "prepare.log"

    with log_path.open("a", encoding="utf-8") as log:
        log.write(f"project: {job['project']}\nsha: {job['sha']}\n")
        log.write("Creating Git archive...\n")
        log.flush()
        try:
            result = subprocess.run(
                [
                    "/usr/bin/git", f"--git-dir={repo}", "archive", "--format=tar",
                    f"--output={archive}", job["sha"],
                ],
                stdout=log, stderr=log, check=False,
            )
            if result.returncode:
                fail(f"git archive failed ({result.returncode})")
            log.write("Extracting archive...\n")
            log.flush()
            result = subprocess.run(
                [
                    "/usr/bin/tar", "-xf", str(archive), "-C", str(src),
                    "--no-same-owner", "--no-same-permissions",
                ],
                stdout=log, stderr=log, check=False,
            )
            if result.returncode:
                fail(f"tar extraction failed ({result.returncode})")
            log.write("Snapshot prepared successfully.\n")
        finally:
            archive.unlink(missing_ok=True)


def load_pipeline_path(repo, sha, path):
    validate_repo_path(path)
    result = git(repo, "show", f"{sha}:{path}")
    if result.returncode:
        fail(f"cannot read {path}: {result.stderr.strip()}")
    raw = result.stdout.encode("utf-8")
    if len(raw) > MAX_PIPELINE_BYTES:
        fail(f"pipeline too large: {path}")
    return raw


def list_ci_pipeline_paths(repo, sha):
    result = git(
        repo,
        "ls-tree",
        "-r",
        "-z",
        "--name-only",
        sha,
        "--",
        CI_PIPELINE_ROOT,
    )
    if result.returncode:
        fail(f"cannot list CI pipelines: {result.stderr.strip()}")

    paths = [
        path
        for path in result.stdout.split("\0")
        if path and path.endswith(".json")
    ]

    if len(paths) > MAX_PIPELINES:
        fail(f"too many CI pipelines: maximum is {MAX_PIPELINES}")

    for path in paths:
        pp = PurePosixPath(path)
        if pp.is_absolute() or ".." in pp.parts or not path.startswith(CI_PIPELINE_ROOT + "/"):
            fail(f"unsafe CI pipeline path: {path}")

    return sorted(paths)


def job_branch(job):
    branch = job.get("branch")
    if isinstance(branch, str) and branch:
        return branch

    ref = job.get("ref", "")
    if isinstance(ref, str) and ref.startswith("refs/heads/"):
        return ref.removeprefix("refs/heads/")

    return None


def parse_pipeline(raw, *, path, kind, cfg, branch=None):
    try:
        return pipeline_schema.load_pipeline_bytes(
            raw,
            kind=kind,
            branch=branch,
            default_max_parallel=cfg["runner"]["max_parallel"],
            allowed_networks=tuple(cfg["runner"]["allowed_networks"]),
        )
    except pipeline_schema.PipelineError as exc:
        fail(f"{path}: {exc}")


def select_ci_pipeline(job, cfg):
    repo = Path(cfg["repository"])
    branch = job_branch(job)
    if not branch:
        fail("CI job does not identify a source branch")

    matches = []
    for path in list_ci_pipeline_paths(repo, job["sha"]):
        raw = load_pipeline_path(repo, job["sha"], path)
        try:
            trigger = pipeline_schema.load_ci_trigger_bytes(raw)
        except pipeline_schema.PipelineError as exc:
            fail(f"{path}: {exc}")
        candidate = {"trigger": trigger}
        if pipeline_schema.matches_branch(candidate, branch):
            matches.append((path, raw))

    if len(matches) > 1:
        names = ", ".join(path for path, _ in matches)
        fail(f"branch {branch!r} matches multiple CI pipelines: {names}")
    if not matches:
        return None

    path, raw = matches[0]
    return path, parse_pipeline(raw, path=path, kind="ci", cfg=cfg, branch=branch)


def select_pipeline(job, cfg):
    repo = Path(cfg["repository"])
    if job["type"] == "release":
        raw = load_pipeline_path(repo, job["sha"], RELEASE_PIPELINE)
        return RELEASE_PIPELINE, parse_pipeline(
            raw,
            path=RELEASE_PIPELINE,
            kind="release",
            cfg=cfg,
        )

    if job["type"] == "ci":
        return select_ci_pipeline(job, cfg)

    fail(f"unsupported job type: {job['type']}")

def resolve_pipeline(job, cfg, pipeline, pipeline_path):
    if not isinstance(pipeline, dict) or pipeline.get("schema") != 1:
        fail("pipeline.schema must be 1")
    jobs = pipeline.get("jobs")
    groups = pipeline.get("groups")
    if not isinstance(jobs, dict) or not jobs:
        fail("normalized pipeline.jobs missing")
    if not isinstance(groups, dict):
        fail("normalized pipeline.groups missing")

    runner = cfg["runner"]
    requested = pipeline.get("max_parallel", runner["max_parallel"])
    if not isinstance(requested, int) or requested < 1:
        fail("pipeline.max_parallel invalid")

    runtime = {
        "schema": 1,
        "build_id": job["id"],
        "project": job["project"],
        "sha": job["sha"],
        "ref": job["ref"],
        "job_type": job["type"],
        "event": job.get("event"),
        "pipeline": pipeline_path,
        "max_parallel": min(requested, runner["max_parallel"]),
        "runner": {
            "cpus": runner["cpus"],
            "memory": runner["memory"],
            "pids_limit": runner["pids_limit"],
            "timeout_seconds": runner["timeout_seconds"],
        },
        "groups": json.loads(json.dumps(groups)),
        "jobs": json.loads(json.dumps(jobs)),
    }

    branch = job_branch(job)
    if branch:
        runtime["branch"] = branch
    if job.get("tag"):
        runtime["tag"] = job["tag"]

    return runtime


def write_makefile(build_dir, runtime):
    job_ids = list(runtime["jobs"])
    lines = [
        ".DELETE_ON_ERROR:",
        ".PHONY: all " + " ".join(f"job-{job_id}" for job_id in job_ids),
        "",
        "all: " + " ".join(f"job-{job_id}" for job_id in job_ids),
        "",
    ]
    build = shlex.quote(runtime["build_id"])
    for job_id, spec in runtime["jobs"].items():
        deps = " ".join(f"job-{dep}" for dep in spec["resolved_needs"])
        lines.append((f"job-{job_id}: {deps}").rstrip())
        lines.append(
            "\t@/usr/local/libexec/kiln/execute "
            f"{build} {shlex.quote(job_id)}"
        )
        lines.append("")
    (build_dir / "pipeline.mk").write_text("\n".join(lines), encoding="utf-8")

def initial_status(job, pipeline_path=None):
    started_at = iso()
    status = {
        "schema": 1,
        "build_id": job["id"],
        "job_id": job["id"],
        "project": job["project"],
        "sha": job["sha"],
        "ref": job["ref"],
        "type": job["type"],
        "event": job.get("event"),
        "pipeline_path": pipeline_path,
        "pipeline": None,
        "prepare": {
            "state": "running",
            "exit_code": None,
            "started_at": started_at,
            "finished_at": None,
            "duration_seconds": None,
            "log": "logs/prepare.log",
        },
        "state": "preparing",
        "received_at": job["received_at"],
        "started_at": started_at,
        "finished_at": None,
        "duration_seconds": None,
    }
    branch = job_branch(job)
    if branch:
        status["branch"] = branch
    if job.get("tag"):
        status["tag"] = job["tag"]
    return status


def create_build_skeleton(job, pipeline_path=None):
    build_dir = BUILDS / job["id"]
    if build_dir.exists():
        fail(f"build already exists: {build_dir}")

    build_dir.mkdir(mode=0o750)
    for name in ("src", "work", "logs", "artifacts", "commands"):
        (build_dir / name).mkdir(mode=0o750)

    write_json(build_dir / "job.json", job)
    write_json(build_dir / "status.json", initial_status(job, pipeline_path))
    return build_dir


def _status_job(spec):
    return {
        "group": spec.get("group"),
        "needs": list(spec.get("needs", [])),
        "resolved_needs": list(spec.get("resolved_needs", [])),
        "inputs": list(spec.get("inputs", [])),
        "resolved_inputs": list(spec.get("resolved_inputs", [])),
        "state": "pending",
        "exit_code": None,
        "started_at": None,
        "finished_at": None,
        "duration_seconds": None,
        "log": None,
    }


def start_pipeline_status(build_dir, status, runtime):
    prepared_at = iso()
    status["pipeline_path"] = runtime["pipeline"]
    status["prepare"].update({
        "state": "success",
        "exit_code": 0,
        "finished_at": prepared_at,
        "duration_seconds": elapsed(status["prepare"]["started_at"]),
    })
    jobs = {}
    for job_id, spec in runtime["jobs"].items():
        job_status = _status_job(spec)
        job_status["log"] = f"logs/{job_id}.log"
        jobs[job_id] = job_status
    status["pipeline"] = {
        "groups": json.loads(json.dumps(runtime["groups"])),
        "jobs": jobs,
    }
    status["state"] = "running"
    write_json(build_dir / "status.json", status)


def fail_status(build_dir, message):
    path = build_dir / "status.json"
    status = read_json(path)
    status["state"] = "failed"
    status["finished_at"] = iso()
    status["duration_seconds"] = elapsed(status["started_at"])

    prepare = status.get("prepare")
    if isinstance(prepare, dict) and prepare.get("state") == "running":
        prepare.update({
            "state": "failed",
            "exit_code": None,
            "error": message,
            "finished_at": iso(),
            "duration_seconds": elapsed(prepare["started_at"]),
        })
    else:
        status["error"] = message

    pipeline = status.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    for job_status in jobs.values():
        if job_status.get("state") == "running":
            job_status["state"] = "failed"
            job_status["error"] = message
        elif job_status.get("state") == "pending":
            job_status["state"] = "skipped"
            job_status["reason"] = "controller_error"
    write_json(path, status)


def finalize(build_dir, make_rc):
    path = build_dir / "status.json"
    status = read_json(path)
    failed = make_rc != 0
    pipeline = status.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    for job_status in jobs.values():
        if job_status["state"] == "pending":
            job_status["state"] = "skipped"
            job_status["reason"] = "dependency_failed"
        elif job_status["state"] not in ("success", "skipped"):
            failed = True
    status["state"] = "failed" if failed else "success"
    status["finished_at"] = iso()
    status["duration_seconds"] = elapsed(status["started_at"])
    write_json(path, status)
    return status["state"]

def claim():
    for source in sorted(INCOMING.glob("*.json")):
        destination = RUNNING / source.name
        try:
            os.replace(source, destination)
            return destination
        except FileNotFoundError:
            pass
    return None


def cleanup_pin(job, cfg):
    expected = "refs/kiln/jobs/" + job["id"]
    if job.get("pin_ref") != expected:
        print(f"kiln: warning: refusing unsafe pin path: {job.get('pin_ref')!r}", file=sys.stderr)
        return
    pin_path = Path(cfg["repository"]) / "refs" / "kiln" / "jobs" / job["id"]
    try:
        pin_path.unlink()
    except FileNotFoundError:
        pass
    except OSError as exc:
        print(f"kiln: warning: cannot delete {job['pin_ref']}: {exc}", file=sys.stderr)


def cleanup_containers(build_id):
    result = subprocess.run(
        ["/usr/bin/docker", "ps", "-aq", "--filter", f"label=kiln.build_id={build_id}"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    ids = result.stdout.split()
    if ids:
        subprocess.run(
            ["/usr/bin/docker", "rm", "-f", *ids],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def recover_stale():
    for job_path in sorted(RUNNING.glob("*.json")):
        try:
            job = read_json(job_path)
            validate_job(job, job_path.name)
            cfg = load_config(job["project"])
        except Exception as exc:
            print(f"kiln: dropping invalid stale job {job_path.name}: {exc}", file=sys.stderr)
            job_path.unlink(missing_ok=True)
            continue

        build_dir = BUILDS / job["id"]
        if not build_dir.exists():
            os.replace(job_path, INCOMING / job_path.name)
            continue

        cleanup_containers(job["id"])
        status_path = build_dir / "status.json"
        if status_path.exists():
            status = read_json(status_path)
            if status.get("state") not in ("success", "failed", "aborted"):
                status["state"] = "aborted"
                status["finished_at"] = iso()
                if status.get("started_at"):
                    status["duration_seconds"] = elapsed(status["started_at"])
                pipeline = status.get("pipeline")
                jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
                for job_status in jobs.values():
                    if job_status.get("state") == "running":
                        job_status["state"] = "failed"
                        job_status["error"] = "controller interrupted"
                    elif job_status.get("state") == "pending":
                        job_status["state"] = "skipped"
                        job_status["reason"] = "controller_interrupted"
                write_json(status_path, status)

        cleanup_pin(job, cfg)
        job_path.unlink(missing_ok=True)


def notify(build_id, build_dir):
    log_path = build_dir / "logs" / "notify.log"
    with log_path.open("a", encoding="utf-8") as log:
        result = subprocess.run(
            ["/usr/local/libexec/kiln/notify-discord", build_id],
            stdout=log,
            stderr=log,
            check=False,
        )
    if result.returncode:
        print(f"kiln: warning: Discord notification failed for {build_id}", file=sys.stderr)


def record_selection_failure(job, cfg, job_path, message):
    build_dir = create_build_skeleton(job)
    with (build_dir / "logs" / "prepare.log").open("a", encoding="utf-8") as log:
        log.write(f"KILN ERROR: {message}\n")
    fail_status(build_dir, message)
    cleanup_pin(job, cfg)
    job_path.unlink(missing_ok=True)
    notify(job["id"], build_dir)
    print(f"kiln: {job['id']} failed: {message}", file=sys.stderr)


def process(job_path):
    job = read_json(job_path)
    validate_job(job, job_path.name)
    cfg = load_config(job["project"])

    try:
        selection = select_pipeline(job, cfg)
    except Exception as exc:
        record_selection_failure(job, cfg, job_path, str(exc))
        return

    if selection is None:
        branch = job_branch(job) or "?"
        cleanup_pin(job, cfg)
        job_path.unlink(missing_ok=True)
        print(f"kiln: {job['id']} ignored: no CI pipeline matches branch {branch!r}")
        return

    pipeline_path, pipeline = selection
    build_dir = create_build_skeleton(job, pipeline_path)

    try:
        extract_snapshot(job, cfg, build_dir)
        runtime = resolve_pipeline(job, cfg, pipeline, pipeline_path)
        write_json(build_dir / "runtime.json", runtime)
        write_makefile(build_dir, runtime)

        status = read_json(build_dir / "status.json")
        start_pipeline_status(build_dir, status, runtime)

        pipeline_log = build_dir / "logs" / "pipeline.log"
        with pipeline_log.open("w", encoding="utf-8") as log:
            make_rc = subprocess.run(
                [
                    "/usr/bin/make",
                    "-f", str(build_dir / "pipeline.mk"),
                    f"-j{runtime['max_parallel']}",
                    "-k",
                    "--output-sync=target",
                    "all",
                ],
                cwd=build_dir,
                stdout=log,
                stderr=log,
                check=False,
            ).returncode

        state = finalize(build_dir, make_rc)
        print(f"kiln: {job['id']} -> {state} ({pipeline_path})")

    except Exception as exc:
        try:
            with (build_dir / "logs" / "prepare.log").open("a", encoding="utf-8") as log:
                log.write(f"\nKILN ERROR: {exc}\n")
            fail_status(build_dir, str(exc))
        except Exception as persist_exc:
            print(f"kiln: cannot persist failure: {persist_exc}", file=sys.stderr)
        print(f"kiln: {job['id']} failed: {exc}", file=sys.stderr)
    finally:
        cleanup_pin(job, cfg)
        job_path.unlink(missing_ok=True)
        notify(job["id"], build_dir)


def main():
    user = pwd.getpwuid(os.geteuid()).pw_name
    if user != "kiln":
        fail(f"controller must run as kiln, not {user}")

    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o640)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0

        recover_stale()
        while True:
            job_path = claim()
            if job_path is None:
                break
            try:
                process(job_path)
            except Exception as exc:
                print(f"kiln: controller error: {exc}", file=sys.stderr)
        return 0
    finally:
        os.close(fd)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KilnError as exc:
        print(f"kiln controller: {exc}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:
        print(f"kiln controller: unexpected error: {exc}", file=sys.stderr)
        sys.exit(1)
