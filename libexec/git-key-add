#!/usr/bin/env python3
import os
import re
import sys
import tempfile
from pathlib import Path

AUTHORIZED_KEYS = Path("/srv/git/.ssh/authorized_keys")
KEY_RE = re.compile(r"^(ssh-ed25519|sk-ssh-ed25519@openssh\.com)\s+([A-Za-z0-9+/=]+)(?:\s+.*)?$")


def fail(message: str):
    print(f"kiln git-key add: {message}", file=sys.stderr)
    sys.exit(1)


def main():
    if os.geteuid() != 0:
        fail("must run as root")

    key = sys.stdin.read(16385).strip()
    if not key or "\n" in key:
        fail("provide exactly one public key")
    if not KEY_RE.fullmatch(key):
        fail("only Ed25519 OpenSSH public keys are accepted")

    current = []
    if AUTHORIZED_KEYS.exists():
        current = [
            line.strip()
            for line in AUTHORIZED_KEYS.read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]

    restricted = "restrict " + key
    if restricted in current:
        print("Git SSH key is already installed.")
        return 0

    current.append(restricted)
    fd, tmp_name = tempfile.mkstemp(prefix=".authorized_keys.", dir=AUTHORIZED_KEYS.parent)
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        import pwd
        git_user = pwd.getpwnam("git")
        os.fchown(fd, git_user.pw_uid, git_user.pw_gid)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(current) + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, AUTHORIZED_KEYS)
        tmp = None
    finally:
        if tmp is not None:
            tmp.unlink(missing_ok=True)

    print("Git SSH key installed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
