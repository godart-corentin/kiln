#!/usr/bin/env python3
import grp
import importlib.util
import os
import sys
from pathlib import Path

SECRETS_ROOT = Path("/etc/kiln/secrets")
CONFIG_ROOT = Path("/etc/kiln/projects")
MODULE = Path(__file__).resolve().with_name("kiln_secrets.py")
spec = importlib.util.spec_from_file_location("kiln_secrets", MODULE)
if spec is None or spec.loader is None:
    raise RuntimeError("cannot load secrets module")
secrets = importlib.util.module_from_spec(spec)
spec.loader.exec_module(secrets)


def fail(message):
    print(f"kiln secret set-file: {message}", file=sys.stderr)
    raise SystemExit(1)


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 4:
        fail("usage: secret-set-file <project> <name> <path>")
    project, name, source_arg = sys.argv[1:]
    if not (CONFIG_ROOT / f"{project}.json").is_file():
        fail(f"project does not exist: {project}")
    source = Path(source_arg)
    if source.is_symlink() or not source.is_file():
        fail(f"secret source is not a regular file: {source}")
    if source.stat().st_size > 16 * 1024 * 1024:
        fail("secret file is too large")
    data = source.read_bytes()
    try:
        secrets.store_secret(
            SECRETS_ROOT,
            project,
            name,
            data,
            kind="file",
            scope="release",
            uid=0,
            gid=grp.getgrnam("kiln").gr_gid,
        )
    except secrets.SecretError as exc:
        fail(str(exc))
    print(f"Secret file {name} configured for {project} (release)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
