#!/usr/bin/env python3
import json
import os
import re
import secrets
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

CONFIG_ROOT = Path("/etc/kiln/projects")
QUEUE_TMP = Path("/var/lib/kiln/queue/tmp")
QUEUE_INCOMING = Path("/var/lib/kiln/queue/incoming")

PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
OID_RE = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")


class KilnError(Exception):
    pass


def fail(message: str) -> None:
    raise KilnError(message)


def git(repo: Path, *args: str) -> str:
    result = subprocess.run(
        ["/usr/bin/git", f"--git-dir={repo}", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        fail(f"git {' '.join(args)} failed: {message}")
    return result.stdout.strip()


def is_zero_oid(oid: str) -> bool:
    return bool(oid) and set(oid) == {"0"}


def validate_oid(name: str, oid: str) -> None:
    if not OID_RE.fullmatch(oid):
        fail(f"invalid {name}: {oid!r}")


def load_project(project: str) -> dict:
    if not PROJECT_RE.fullmatch(project):
        fail(f"invalid project name: {project!r}")

    path = CONFIG_ROOT / f"{project}.json"
    try:
        with path.open("r", encoding="utf-8") as f:
            config = json.load(f)
    except FileNotFoundError:
        fail(f"project configuration not found: {path}")
    except json.JSONDecodeError as exc:
        fail(f"invalid project configuration {path}: {exc}")

    if config.get("schema") != 1:
        fail(f"unsupported project schema in {path}")
    if config.get("project") != project:
        fail(f"project name mismatch in {path}")

    expected_repo = Path("/srv/git") / f"{project}.git"
    repository = config.get("repository")
    if repository != str(expected_repo):
        fail(f"repository path must be {expected_repo}")
    return config


def classify(config: dict, old_oid: str, new_oid: str, ref: str):
    if is_zero_oid(new_oid):
        return None

    if ref.startswith("refs/heads/"):
        branch = ref.removeprefix("refs/heads/")
        branches = config.get("ci", {}).get("branches", [])
        return "ci" if branch in branches else None

    if ref.startswith("refs/tags/"):
        tag = ref.removeprefix("refs/tags/")
        if not is_zero_oid(old_oid):
            return None
        pattern = config.get("release", {}).get("tag_pattern")
        if not isinstance(pattern, str):
            fail("release.tag_pattern is missing or invalid")
        try:
            return "release" if re.fullmatch(pattern, tag) else None
        except re.error as exc:
            fail(f"invalid release.tag_pattern: {exc}")

    return None


def atomic_publish(job_id: str, job: dict) -> Path:
    tmp_path = QUEUE_TMP / f".{job_id}.{secrets.token_hex(4)}.tmp"
    final_path = QUEUE_INCOMING / f"{job_id}.json"
    fd = None
    try:
        fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            json.dump(job, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())

        os.replace(tmp_path, final_path)
        dir_fd = os.open(QUEUE_INCOMING, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    finally:
        if fd is not None:
            os.close(fd)
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass
    return final_path


def main() -> int:
    if len(sys.argv) != 5:
        print("usage: enqueue <project> <old-oid> <new-oid> <ref>", file=sys.stderr)
        return 2

    project, old_oid, new_oid, ref = sys.argv[1:]
    validate_oid("old oid", old_oid)
    validate_oid("new oid", new_oid)

    config = load_project(project)
    job_type = classify(config, old_oid, new_oid, ref)
    if job_type is None:
        return 0

    repo = Path(config["repository"])
    if not repo.is_dir():
        fail(f"repository does not exist: {repo}")

    commit_sha = git(repo, "rev-parse", "--verify", f"{new_oid}^{{commit}}")
    validate_oid("commit sha", commit_sha)

    now = datetime.now(timezone.utc)
    timestamp = now.strftime("%Y%m%dT%H%M%S%fZ")
    job_id = f"{timestamp}-{project}-{commit_sha[:7]}-{secrets.token_hex(4)}"
    pin_ref = f"refs/kiln/jobs/{job_id}"

    git(repo, "update-ref", pin_ref, commit_sha)
    published = False
    try:
        job = {
            "schema": 1,
            "id": job_id,
            "project": project,
            "received_at": now.isoformat().replace("+00:00", "Z"),
            "old_sha": old_oid,
            "new_sha": new_oid,
            "sha": commit_sha,
            "ref": ref,
            "type": job_type,
            "pin_ref": pin_ref,
        }
        atomic_publish(job_id, job)
        published = True
    finally:
        if not published:
            subprocess.run(
                ["/usr/bin/git", f"--git-dir={repo}", "update-ref", "-d", pin_ref],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    print(job_id)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KilnError as exc:
        print(f"kiln enqueue: {exc}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:
        print(f"kiln enqueue: unexpected error: {exc}", file=sys.stderr)
        sys.exit(1)
