#!/usr/bin/env python3
import json
import os
import re
import secrets
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

LIBEXEC_ROOT = str(Path(__file__).resolve().parent)
if LIBEXEC_ROOT not in sys.path:
    sys.path.insert(0, LIBEXEC_ROOT)

from kilnr_project_lock import project_locks, validate_project_name

CONFIG_ROOT = Path("/etc/kilnr/projects")
GIT_ROOT = Path("/srv/git")
PROJECT_LOCK_ROOT = Path("/var/lib/kilnr/locks/projects")
QUEUE_TMP = Path("/var/lib/kilnr/queue/tmp")
QUEUE_INCOMING = Path("/var/lib/kilnr/queue/incoming")

PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
OID_RE = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")


class KilnrError(Exception):
    pass


def fail(message: str) -> None:
    raise KilnrError(message)


def git(repo: Path, *args: str) -> str:
    result = subprocess.run(
        ["/usr/bin/git", f"--git-dir={repo}", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        fail(f"git {' '.join(args)} failed: {message}")
    return result.stdout.strip()


def is_zero_oid(oid: str) -> bool:
    return bool(oid) and set(oid) == {"0"}


def validate_oid(name: str, oid: str) -> None:
    if not OID_RE.fullmatch(oid):
        fail(f"invalid {name}: {oid!r}")


def load_project(project: str) -> dict:
    if not PROJECT_RE.fullmatch(project):
        fail(f"invalid project name: {project!r}")

    path = CONFIG_ROOT / f"{project}.json"
    try:
        with path.open("r", encoding="utf-8") as f:
            config = json.load(f)
    except FileNotFoundError:
        fail(f"project configuration not found: {path}")
    except json.JSONDecodeError as exc:
        fail(f"invalid project configuration {path}: {exc}")

    if config.get("schema") != 1:
        fail(f"unsupported project schema in {path}")
    if config.get("project") != project:
        fail(f"project name mismatch in {path}")

    expected_repo = GIT_ROOT / f"{project}.git"
    repository = config.get("repository")
    if repository != str(expected_repo):
        fail(f"repository path must be {expected_repo}")
    return config


def classify(config: dict, old_oid: str, new_oid: str, ref: str):
    """Classify a Git ref update without selecting a CI pipeline.

    Branch policy lives in the repository under .kilnr/pipelines/*.json.
    Therefore every non-deletion branch push becomes a lightweight CI job;
    the controller later selects the single matching branch pipeline from the
    exact received SHA. A branch with no matching pipeline is silently ignored
    by the controller.

    Releases remain server-gated: only the initial creation of a matching tag
    can become a release job.
    """

    if is_zero_oid(new_oid):
        return None

    if ref.startswith("refs/heads/"):
        return "ci"

    if ref.startswith("refs/tags/"):
        tag = ref.removeprefix("refs/tags/")
        if not is_zero_oid(old_oid):
            return None
        pattern = config.get("release", {}).get("tag_pattern")
        if not isinstance(pattern, str):
            fail("release.tag_pattern is missing or invalid")
        try:
            return "release" if re.fullmatch(pattern, tag) else None
        except re.error as exc:
            fail(f"invalid release.tag_pattern: {exc}")

    return None


def atomic_publish(job_id: str, job: dict) -> Path:
    tmp_path = QUEUE_TMP / f".{job_id}.{secrets.token_hex(4)}.tmp"
    final_path = QUEUE_INCOMING / f"{job_id}.json"

    fd = None
    dir_fd = None

    try:
        # Open the destination directory before publishing anything.
        # This verifies that the enqueue identity can perform the
        # directory fsync required after the atomic rename.
        dir_fd = os.open(
            QUEUE_INCOMING,
            os.O_RDONLY | os.O_DIRECTORY,
        )

        fd = os.open(
            tmp_path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o640,
        )

        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            json.dump(job, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())

        os.replace(tmp_path, final_path)
        os.fsync(dir_fd)

    finally:
        if fd is not None:
            os.close(fd)

        if dir_fd is not None:
            os.close(dir_fd)

        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass

    return final_path


def resolve_receive_repository():
    result = subprocess.run(
        ["/usr/bin/git", "rev-parse", "--absolute-git-dir"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        fail(f"cannot determine receive repository: {message}")
    repository = Path(result.stdout.strip())
    try:
        repository = repository.resolve(strict=True)
        git_root = GIT_ROOT.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot resolve receive repository: {exc}")
    if repository.parent != git_root or not repository.name.endswith(".git"):
        fail(f"receive repository is outside {git_root}: {repository}")
    project = repository.name[:-4]
    try:
        validate_project_name(project)
    except ValueError as exc:
        fail(str(exc))
    return project, repository


def enqueue_locked(
    project: str,
    old_oid: str,
    new_oid: str,
    ref: str,
    *,
    repository=None,
):
    config = load_project(project)
    repo = Path(config["repository"])
    if repository is not None and repo != repository:
        fail(
            "receive repository identity changed while locked: "
            f"expected {repository}, configured {repo}"
        )
    job_type = classify(config, old_oid, new_oid, ref)
    if job_type is None:
        return 0

    if not repo.is_dir():
        fail(f"repository does not exist: {repo}")

    commit_sha = git(repo, "rev-parse", "--verify", f"{new_oid}^{{commit}}")
    validate_oid("commit sha", commit_sha)

    now = datetime.now(timezone.utc)
    timestamp = now.strftime("%Y%m%dT%H%M%S%fZ")
    job_id = f"{timestamp}-{project}-{commit_sha[:7]}-{secrets.token_hex(4)}"
    pin_ref = f"refs/kilnr/jobs/{job_id}"

    git(repo, "update-ref", pin_ref, commit_sha)
    published = False
    try:
        job = {
            "schema": 1,
            "id": job_id,
            "project": project,
            "received_at": now.isoformat().replace("+00:00", "Z"),
            "old_sha": old_oid,
            "new_sha": new_oid,
            "sha": commit_sha,
            "ref": ref,
            "type": job_type,
            "event": "push" if job_type == "ci" else "tag",
            "pin_ref": pin_ref,
        }

        if job_type == "ci":
            job["branch"] = ref.removeprefix("refs/heads/")
        else:
            job["tag"] = ref.removeprefix("refs/tags/")

        atomic_publish(job_id, job)
        published = True
    finally:
        if not published:
            subprocess.run(
                ["/usr/bin/git", f"--git-dir={repo}", "update-ref", "-d", pin_ref],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    print(job_id)
    return 0


def enqueue_receive(old_oid: str, new_oid: str, ref: str) -> int:
    while True:
        project, repository = resolve_receive_repository()
        with project_locks(PROJECT_LOCK_ROOT, [project], exclusive=False):
            locked_project, locked_repository = resolve_receive_repository()
            if (locked_project, locked_repository) != (project, repository):
                continue
            return enqueue_locked(
                project,
                old_oid,
                new_oid,
                ref,
                repository=repository,
            )


def main() -> int:
    if len(sys.argv) != 5:
        print("usage: enqueue <project> <old-oid> <new-oid> <ref>", file=sys.stderr)
        return 2

    project_or_receive, old_oid, new_oid, ref = sys.argv[1:]
    validate_oid("old oid", old_oid)
    validate_oid("new oid", new_oid)

    if project_or_receive == "--receive":
        return enqueue_receive(old_oid, new_oid, ref)
    try:
        project = validate_project_name(project_or_receive)
    except ValueError as exc:
        fail(str(exc))
    with project_locks(PROJECT_LOCK_ROOT, [project], exclusive=False):
        enqueue_locked(project, old_oid, new_oid, ref)
    # project lock released
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KilnrError as exc:
        print(f"kilnr enqueue: {exc}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:
        print(f"kilnr enqueue: unexpected error: {exc}", file=sys.stderr)
        sys.exit(1)
