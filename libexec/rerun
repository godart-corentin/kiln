#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from contextlib import ExitStack

from kilnr_project_lock import project_locks, _open_directory_chain
from kilnr_retention import BUILD_RE as STRUCTURED_BUILD_RE, directory, read_json

PROJECT_LOCK_ROOT = Path("/var/lib/kilnr/locks/projects")

BUILDS = Path("/var/lib/kilnr/builds")
ENQUEUE = "/usr/local/libexec/kilnr/enqueue"
RUNUSER = "/usr/sbin/runuser"
BUILD_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
OID_RE = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")


def fail(message):
    print(f"kilnr rerun: {message}", file=sys.stderr)
    sys.exit(1)


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2:
        fail("usage: rerun <build-id>")

    build_id = sys.argv[1]
    if not BUILD_RE.fullmatch(build_id):
        fail("invalid build id")

    match = STRUCTURED_BUILD_RE.fullmatch(build_id)
    if not match:
        fail("invalid structured build id")
    with project_locks(PROJECT_LOCK_ROOT, [match[2]], exclusive=False):
        return rerun_locked(build_id, match[2])


def rerun_locked(build_id, expected_project):
    try:
        with ExitStack() as stack:
            root = _open_directory_chain(stack, BUILDS)[1][-1][1]
            with directory(build_id, root) as fd:
                status = read_json(fd, "status.json")
    except Exception as exc:
        fail(f"cannot read build: {exc}")

    if status.get("project") != expected_project:
        fail("project identity mismatch")
    if status.get("build_id") != build_id:
        fail("build id mismatch")
    if status.get("type") != "ci":
        fail("release builds cannot be rerun")

    project = status.get("project")
    sha = status.get("sha")
    ref = status.get("ref")
    if not isinstance(project, str) or not PROJECT_RE.fullmatch(project):
        fail("invalid project")
    if not isinstance(sha, str) or not OID_RE.fullmatch(sha):
        fail("invalid SHA")
    if not isinstance(ref, str) or not ref.startswith("refs/heads/"):
        fail("CI rerun must reference a branch")

    result = subprocess.run(
        [RUNUSER, "-u", "git", "--", ENQUEUE, project, sha, sha, ref],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or result.stdout.strip() or "enqueue failed")

    new_job_id = result.stdout.strip()
    if not new_job_id:
        fail("build is no longer eligible for CI")
    print(f"Queued rerun: {new_job_id}")
    print(f"SHA: {sha}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
