#!/usr/bin/env python3
import importlib.util
import os
import sys
from pathlib import Path

SECRETS_ROOT = Path("/etc/kiln/secrets")
CONFIG_ROOT = Path("/etc/kiln/projects")
MODULE = Path(__file__).resolve().with_name("kiln_secrets.py")
spec = importlib.util.spec_from_file_location("kiln_secrets", MODULE)
if spec is None or spec.loader is None:
    raise RuntimeError("cannot load secrets module")
secrets = importlib.util.module_from_spec(spec)
spec.loader.exec_module(secrets)


def fail(message):
    print(f"kiln secret list: {message}", file=sys.stderr)
    raise SystemExit(1)


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2:
        fail("usage: secret-list <project>")
    project = sys.argv[1]
    if not (CONFIG_ROOT / f"{project}.json").is_file():
        fail(f"project does not exist: {project}")
    try:
        rows = secrets.list_secrets(SECRETS_ROOT, project)
    except secrets.SecretError as exc:
        fail(str(exc))
    for item in rows:
        print(f"{item['name']}\t{item['scope']}\t{item['kind']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
