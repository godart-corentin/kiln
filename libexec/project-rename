LOCK_MODULE_PATH = Path(__file__).resolve().with_name("kilnr_project_lock.py")
_LOCK_SPEC = importlib.util.spec_from_file_location("kilnr_project_lock", LOCK_MODULE_PATH)
if _LOCK_SPEC is None or _LOCK_SPEC.loader is None:
    raise RuntimeError(f"cannot load project lock module: {LOCK_MODULE_PATH}")
project_lock = importlib.util.module_from_spec(_LOCK_SPEC)
_LOCK_SPEC.loader.exec_module(project_lock)
validate_project_name = project_lock.validate_project_name
project_locks = project_lock.project_locks
provision_project_locks = project_lock.provision_project_locks

MAX_JSON_BYTES = 4 * 1024 * 1024
