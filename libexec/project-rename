class RenameError(RuntimeError):
    pass


@dataclass(frozen=True)
class Roots:
    git: Path
    config: Path
    secrets: Path
    state: Path
    locks: Path
    managed_hook: Optional[Path] = None


@dataclass(frozen=True)
class ProductionPolicy:
    root: tuple
    git: tuple
    kilnr: tuple
    submit_gid: int
    kilnr_groups: frozenset


@dataclass(frozen=True)
class PathMove:
    source: Path
    destination: Path


@dataclass(frozen=True)
class FileFacts:
    mode: int
    uid: int
    gid: int
    acl: tuple


@dataclass(frozen=True)
class MetadataWrite:
    source: Path
    destination: Path
    data: bytes
    is_json: bool
    stage_directory: Path
    facts: FileFacts


@dataclass(frozen=True)
class RenameInventory:
    roots: Roots
    old: str
    new: str
    repository: PathMove
    config_file: PathMove
    webhook: PathMove
    secret_directory: PathMove
    cache: Optional[PathMove]
    builds: tuple[PathMove, ...]
    build_ids: dict[str, str]
    pin_refs: dict[str, str]
    metadata_writes: tuple[MetadataWrite, ...]
    source_facts: dict

    @property
    def path_moves(self):
        fixed = (
            self.repository,
            self.config_file,
            self.webhook,
            self.secret_directory,
        )
        optional = () if self.cache is None else (self.cache,)
        return fixed + optional + self.builds

    @property
    def config(self):
        return self.config_file


@dataclass(frozen=True)
class PreparedFile:
    write: MetadataWrite
    temporary: Path

    @property
    def temporary_after_moves(self):
        return self.write.destination.parent / self.temporary.name


@dataclass(frozen=True)
class PreparedRename:
    inventory: RenameInventory
    files: tuple[PreparedFile, ...]

    def cleanup(self):
        for item in self.files:
            candidates = {item.temporary, item.temporary_after_moves}
            for path in candidates:
                try:
                    path.unlink()
                except FileNotFoundError:
                    pass


DEFAULT_ROOTS = Roots(
    git=Path("/srv/git"),
    config=Path("/etc/kilnr/projects"),
    secrets=Path("/etc/kilnr/secrets"),
    state=Path("/var/lib/kilnr"),
    locks=Path("/var/lib/kilnr/locks/projects"),
)


def _fail(message):
    raise RenameError(message)


def _lexists(path):
    return os.path.lexists(path)


def _require_absent(path, description="destination"):
    if _lexists(path):
        _fail(f"{description} exists: {path}")


def _lstat(path, description):
    try:
        info = path.lstat()
    except FileNotFoundError:
        _fail(f"{description} missing: {path}")
    if stat.S_ISLNK(info.st_mode):
        _fail(f"{description} is a symlink: {path}")
    return info


def _require_directory(path, description):
    info = _lstat(path, description)
    if not stat.S_ISDIR(info.st_mode):
        _fail(f"{description} is not a directory: {path}")
    return info


def _require_regular(path, description):
    info = _lstat(path, description)
    if not stat.S_ISREG(info.st_mode):
        _fail(f"{description} is not a regular file: {path}")
    return info


def _read_acl(path):
    if not hasattr(os, "listxattr") or not hasattr(os, "getxattr"):
        return ()
    try:
        try:
            names = os.listxattr(path, follow_symlinks=False)
        except TypeError:
            names = os.listxattr(path)
    except OSError as exc:
        if exc.errno in (errno.ENOTSUP, errno.EOPNOTSUPP):
            return ()
        _fail(f"cannot inventory ACLs for {path}: {exc}")
    acl = []
    for name in names:
        normalized = os.fsdecode(name)
        if "acl" not in normalized.lower():
            continue
        try:
            try:
                value = os.getxattr(path, name, follow_symlinks=False)
            except TypeError:
                value = os.getxattr(path, name)
        except OSError as exc:
            _fail(f"cannot read ACL {normalized!r} for {path}: {exc}")
        acl.append((normalized, value))
    return tuple(sorted(acl))


def _record_facts(
    facts,
    path,
    description,
    *,
    expected_mode=None,
    expected_owner=None,
    require_regular=False,
    require_directory=False,
):
    if require_regular:
        info = _require_regular(path, description)
    elif require_directory:
        info = _require_directory(path, description)
    else:
        info = _lstat(path, description)
    mode = stat.S_IMODE(info.st_mode)
    if expected_mode is not None and mode != expected_mode:
        _fail(f"unexpected mode for {path}: {mode:#06o}, expected {expected_mode:#06o}")
    if expected_owner is not None and (info.st_uid, info.st_gid) != expected_owner:
        _fail(
            f"unexpected ownership for {path}: {info.st_uid}:{info.st_gid}, "
            f"expected {expected_owner[0]}:{expected_owner[1]}"
        )
    result = FileFacts(
        mode=mode,
        uid=info.st_uid,
        gid=info.st_gid,
        acl=_read_acl(path),
    )
    facts[path] = result
    return result


def _require_not_writable_by_group_or_other(facts, path, description, *, owner):
    result = _record_facts(facts, path, description, expected_owner=owner)
    if result.mode & 0o022:
        _fail(f"managed path is writable by group or others: {path}")
    return result


def _production_policy(roots):
    if roots != DEFAULT_ROOTS:
        return None
    try:
        git_user = pwd.getpwnam("git")
        kilnr_user = pwd.getpwnam("kilnr")
        git_group = grp.getgrnam("git")
        kilnr_group = grp.getgrnam("kilnr")
        submit_group = grp.getgrnam("kilnr-submit")
    except KeyError as exc:
        _fail(f"required production identity is missing: {exc}")
    if git_user.pw_gid != git_group.gr_gid:
        _fail("Linux user 'git' does not use group 'git' as its primary group")
    if kilnr_user.pw_gid != kilnr_group.gr_gid:
        _fail("Linux user 'kilnr' does not use group 'kilnr' as its primary group")
    kilnr_groups = {kilnr_user.pw_gid}
    for group in grp.getgrall():
        if "kilnr" in group.gr_mem:
            kilnr_groups.add(group.gr_gid)
    return ProductionPolicy(
        root=(0, 0),
        git=(git_user.pw_uid, git_group.gr_gid),
        kilnr=(kilnr_user.pw_uid, kilnr_group.gr_gid),
        submit_gid=submit_group.gr_gid,
        kilnr_groups=frozenset(kilnr_groups),
    )


def _managed_hook_owner(roots):
    if roots == DEFAULT_ROOTS:
        return (0, 0)
    info = _require_regular(_managed_hook_path(roots), "managed post-receive hook")
    return (info.st_uid, info.st_gid)


def _managed_hook_path(roots):
    if roots.managed_hook is not None:
        return roots.managed_hook
    return Path(__file__).resolve().with_name("git-hooks") / "post-receive"


def _kilnr_acl_uid(roots):
    if roots != DEFAULT_ROOTS:
        return None
    try:
        return pwd.getpwnam("kilnr").pw_uid
    except KeyError:
        _fail("Linux user 'kilnr' does not exist")


def _decode_posix_acl(value, path, acl_name):
    if len(value) < 4 or (len(value) - 4) % 8:
        _fail(f"invalid {acl_name} ACL encoding for {path}")
    version = struct.unpack_from("<I", value)[0]
    if version != 2:
        _fail(f"invalid {acl_name} ACL version for {path}")
    entries = []
    for offset in range(4, len(value), 8):
        tag, permissions, entry_id = struct.unpack_from("<HHI", value, offset)
        if tag not in (0x01, 0x02, 0x04, 0x08, 0x10, 0x20) or permissions & ~0o7:
            _fail(f"invalid {acl_name} ACL entry for {path}")
        entries.append((tag, permissions, entry_id))
    return tuple(entries)


def _access_acl_entries(path, facts):
    acl = dict(facts.acl)
    value = acl.get("system.posix_acl_access")
    if value is None:
        return None
    return _decode_posix_acl(value, path, "system.posix_acl_access")


def _validate_no_extra_metadata_writers(path, facts):
    entries = _access_acl_entries(path, facts)
    if entries is None:
        if facts.mode & 0o022:
            _fail(f"unexpected metadata writer permitted by mode: {path}")
        return
    masks = [permissions for tag, permissions, _ in entries if tag == 0x10]
    if len(masks) != 1:
        _fail(f"invalid metadata access ACL mask: {path}")
    mask = masks[0]
    for tag, permissions, _entry_id in entries:
        if tag in (0x02, 0x04, 0x08):
            permissions &= mask
        if tag in (0x02, 0x04, 0x08, 0x20) and permissions & 0o2:
            _fail(f"unexpected metadata writer in access ACL: {path}")


def _identity_can_write(path, facts, uid, gids):
    entries = _access_acl_entries(path, facts)
    if entries is None:
        if uid == facts.uid:
            permissions = (facts.mode >> 6) & 0o7
        elif facts.gid in gids:
            permissions = (facts.mode >> 3) & 0o7
        else:
            permissions = facts.mode & 0o7
        return bool(permissions & 0o2)

    by_tag = {}
    for tag, permissions, entry_id in entries:
        by_tag.setdefault(tag, []).append((entry_id, permissions))
    masks = by_tag.get(0x10, ())
    if len(masks) != 1:
        _fail(f"invalid access ACL mask for {path}")
    mask = masks[0][1]
    if uid == facts.uid:
        owners = by_tag.get(0x01, ())
        if len(owners) != 1:
            _fail(f"invalid access ACL owner for {path}")
        return bool(owners[0][1] & 0o2)
    named_users = [
        permissions
        for entry_id, permissions in by_tag.get(0x02, ())
        if entry_id == uid
    ]
    if named_users:
        return bool(named_users[0] & mask & 0o2)
    group_permissions = 0
    if facts.gid in gids:
        groups = by_tag.get(0x04, ())
        if len(groups) != 1:
            _fail(f"invalid access ACL owning group for {path}")
        group_permissions |= groups[0][1]
    for entry_id, permissions in by_tag.get(0x08, ()):
        if entry_id in gids:
            group_permissions |= permissions
    if group_permissions:
        return bool(group_permissions & mask & 0o2)
    others = by_tag.get(0x20, ())
    if len(others) != 1:
        _fail(f"invalid access ACL other entry for {path}")
    return bool(others[0][1] & 0o2)


def _validate_kilnr_ref_acl(path, facts, kilnr_uid):
    if kilnr_uid is None:
        return
    acl = dict(facts.acl)
    expected_entries = {
        (0x01, 0o7, 0xFFFFFFFF),
        (0x02, 0o7, kilnr_uid),
        (0x04, 0o5, 0xFFFFFFFF),
        (0x10, 0o7, 0xFFFFFFFF),
        (0x20, 0o0, 0xFFFFFFFF),
    }
    for acl_name in ("system.posix_acl_access", "system.posix_acl_default"):
        value = acl.get(acl_name)
        if value is None:
            _fail(f"repository Kilnr ref ACL is missing for {path}: {acl_name}")
        entries = _decode_posix_acl(value, path, acl_name)
        if len(entries) != len(expected_entries) or set(entries) != expected_entries:
            _fail(f"repository Kilnr ref ACL policy is invalid for {path}: {acl_name}")


def _validate_kilnr_loose_ref_acl(path, facts, kilnr_uid):
    if kilnr_uid is None:
        if facts.mode & 0o022 and facts.mode != 0o660:
            _fail(f"unexpected mode for managed loose pin ref {path}: {facts.mode:#06o}")
        return
    if facts.mode != 0o660:
        _fail(
            f"unexpected mode for managed loose pin ref {path}: "
            f"{facts.mode:#06o}, expected 0o0660"
        )
    acl = dict(facts.acl)
    if set(acl) != {"system.posix_acl_access"}:
        _fail(f"repository loose Kilnr ref ACL policy is invalid for {path}")
    expected_entries = {
        (0x01, 0o6, 0xFFFFFFFF),
        (0x02, 0o7, kilnr_uid),
        (0x04, 0o5, 0xFFFFFFFF),
        (0x10, 0o6, 0xFFFFFFFF),
        (0x20, 0o0, 0xFFFFFFFF),
    }
    entries = _decode_posix_acl(
        acl["system.posix_acl_access"],
        path,
        "system.posix_acl_access",
    )
    if len(entries) != len(expected_entries) or set(entries) != expected_entries:
        _fail(f"repository loose Kilnr ref ACL policy is invalid for {path}")


def _require_same_filesystem(move):
    source_info = _lstat(move.source, "move source")
    destination_parent = _require_directory(
        move.destination.parent, "move destination parent"
    )
    if source_info.st_dev != destination_parent.st_dev:
        _fail(
            "source and destination must be on the same filesystem: "
            f"{move.source} -> {move.destination}"
        )


def _read_regular_bytes(path, description, *, limit=None):
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        _fail(f"{description} missing: {path}")
    except OSError as exc:
        if path.is_symlink():
            _fail(f"{description} is a symlink: {path}")
        _fail(f"cannot open {description} {path}: {exc}")
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            _fail(f"{description} is not a regular file: {path}")
        if limit is not None and info.st_size > limit:
            _fail(f"{description} is too large: {path}")
        chunks = []
        remaining = None if limit is None else limit + 1
        while remaining is None or remaining > 0:
            chunk = os.read(fd, 65536 if remaining is None else min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            if remaining is not None:
                remaining -= len(chunk)
        data = b"".join(chunks)
        if limit is not None and len(data) > limit:
            _fail(f"{description} is too large: {path}")
        return data
    finally:
        os.close(fd)


def _read_json(path, description):
    raw = _read_regular_bytes(path, description, limit=MAX_JSON_BYTES)
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        _fail(f"invalid JSON in {description} {path}: {exc}")
    if not isinstance(value, dict):
        _fail(f"invalid JSON object in {description}: {path}")
    return value


def _json_bytes(value):
    return (json.dumps(value, indent=2) + "\n").encode("utf-8")


def _validated_name(name):
    try:
        return validate_project_name(name)
    except ValueError as exc:
        _fail(str(exc))


def _validate_roots(roots, production=None):
    for path, description in (
        (roots.git, "Git root"),
        (roots.config, "project config root"),
        (roots.secrets, "secret root"),
        (roots.state, "state root"),
        (roots.locks, "project lock root"),
    ):
        _require_directory(path, description)
    if production is not None:
        production_paths = (
            (roots.git, "Git root", 0o755, production.root),
            (roots.config, "project config root", 0o755, production.root),
            (
                roots.secrets,
                "secret root",
                0o750,
                (production.root[0], production.kilnr[1]),
            ),
            (
                roots.state,
                "state root",
                0o710,
                (production.root[0], production.submit_gid),
            ),
            (
                roots.locks.parent,
                "lock parent",
                0o750,
                (production.root[0], production.kilnr[1]),
            ),
            (
                roots.locks,
                "project lock root",
                0o2750,
                (production.root[0], production.submit_gid),
            ),
            (
                roots.state / "queue",
                "queue root",
                0o710,
                (production.kilnr[0], production.submit_gid),
            ),
            (roots.state / "builds", "build root", 0o750, production.kilnr),
            (roots.state / "cache", "cache root", 0o700, production.kilnr),
        )
        checked = {}
        for path, description, mode, owner in production_paths:
            _record_facts(
                checked,
                path,
                description,
                expected_mode=mode,
                expected_owner=owner,
                require_directory=True,
            )
    for path, description in (
        (roots.state / "queue", "queue root"),
        (roots.state / "builds", "build root"),
        (roots.state / "cache", "cache root"),
    ):
        _require_directory(path, description)


def _validate_config(config, path, old, repository, webhook):
    if config.get("schema") != 1:
        _fail(f"invalid project config schema: {path}")
    if config.get("project") != old:
        _fail(f"project config identity mismatch: {path}")
    if config.get("repository") != str(repository):
        _fail(f"project config repository mismatch: {path}")
    discord = config.get("discord")
    if not isinstance(discord, dict) or discord.get("webhook_file") != str(webhook):
        _fail(f"project config webhook mismatch: {path}")
    release = config.get("release")
    if not isinstance(release, dict) or not isinstance(release.get("tag_pattern"), str):
        _fail(f"project config release policy is invalid: {path}")
    try:
        re.compile(release["tag_pattern"])
    except re.error as exc:
        _fail(f"project config release pattern is invalid: {path}: {exc}")
    runner = config.get("runner")
    if not isinstance(runner, dict):
        _fail(f"project config runner is invalid: {path}")
    if (
        not isinstance(runner.get("max_parallel"), int)
        or isinstance(runner.get("max_parallel"), bool)
        or not 1 <= runner["max_parallel"] <= 32
    ):
        _fail(f"project config runner.max_parallel is invalid: {path}")
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", str(runner.get("cpus", ""))):
        _fail(f"project config runner.cpus is invalid: {path}")
    if not re.fullmatch(r"[0-9]+[kKmMgG]", str(runner.get("memory", ""))):
        _fail(f"project config runner.memory is invalid: {path}")
    if (
        not isinstance(runner.get("pids_limit"), int)
        or isinstance(runner.get("pids_limit"), bool)
        or not 16 <= runner["pids_limit"] <= 65535
    ):
        _fail(f"project config runner.pids_limit is invalid: {path}")
    if (
        not isinstance(runner.get("timeout_seconds"), int)
        or isinstance(runner.get("timeout_seconds"), bool)
        or not 1 <= runner["timeout_seconds"] <= 86400
    ):
        _fail(f"project config runner.timeout_seconds is invalid: {path}")
    networks = runner.get("allowed_networks")
    if (
        not isinstance(networks, list)
        or not networks
        or any(network not in ("none", "kilnr-ci") for network in networks)
    ):
        _fail(f"project config runner.allowed_networks is invalid: {path}")


def _validate_bare_repository(
    path,
    facts,
    *,
    managed_hook_owner,
    managed_hook_path,
    kilnr_acl_uid,
    expected_owner=None,
    kilnr_identity=None,
):
    repository_facts = _record_facts(
        facts,
        path,
        "source repository",
        expected_mode=0o750,
        expected_owner=expected_owner,
        require_directory=True,
    )
    owner = (repository_facts.uid, repository_facts.gid)
    for name in ("HEAD", "config"):
        if expected_owner is None:
            file_facts = _require_not_writable_by_group_or_other(
                facts,
                path / name,
                f"repository {name}",
                owner=owner,
            )
            _require_regular(path / name, f"repository {name}")
        else:
            file_facts = _record_facts(
                facts,
                path / name,
                f"repository {name}",
                expected_mode=0o644,
                expected_owner=owner,
                require_regular=True,
            )
            _validate_no_extra_metadata_writers(path / name, file_facts)
    for name in ("objects", "refs", "hooks"):
        child = path / name
        if expected_owner is None:
            _require_directory(child, f"repository {name}")
            _require_not_writable_by_group_or_other(
                facts, child, f"repository {name}", owner=owner
            )
        else:
            _record_facts(
                facts,
                child,
                f"repository {name}",
                expected_mode=0o755,
                expected_owner=owner,
                require_directory=True,
            )

    if expected_owner is not None:
        heads = path / "refs" / "heads"
        heads_facts = _record_facts(
            facts,
            heads,
            "repository branch refs",
            expected_mode=0o755,
            expected_owner=owner,
            require_directory=True,
        )
        if kilnr_identity is not None and _identity_can_write(
            heads,
            heads_facts,
            kilnr_identity[0],
            kilnr_identity[1],
        ):
            _fail(f"kilnr can write refs/heads: {heads}")

    head = _read_regular_bytes(path / "HEAD", "repository HEAD", limit=1024)
    try:
        head_text = head.decode("ascii").strip()
    except UnicodeDecodeError:
        _fail(f"repository HEAD is invalid: {path / 'HEAD'}")
    if not re.fullmatch(r"ref: refs/heads/[A-Za-z0-9._/-]+", head_text):
        _fail(f"repository HEAD is invalid: {path / 'HEAD'}")

    parser = configparser.RawConfigParser(strict=True)
    try:
        config_text = _read_regular_bytes(
            path / "config", "repository config", limit=1024 * 1024
        ).decode("utf-8")
        parser.read_string(config_text)
    except (UnicodeDecodeError, configparser.Error) as exc:
        _fail(f"repository config is invalid: {path / 'config'}: {exc}")
    if parser.get("core", "bare", fallback="").lower() != "true":
        _fail(f"repository core.bare is invalid: {path}")
    if parser.get("transfer", "hiderefs", fallback="") != "refs/kilnr/":
        _fail(f"repository transfer.hideRefs is invalid: {path}")
    if parser.get("gc", "packrefs", fallback="").lower() != "false":
        _fail(f"repository gc.packRefs is invalid: {path}")

    expected_hook = managed_hook_path
    hook = path / "hooks" / "post-receive"
    if not hook.is_symlink():
        _fail(f"repository post-receive hook is not the managed symlink: {hook}")
    try:
        hook_target = hook.resolve(strict=True)
    except (FileNotFoundError, RuntimeError, OSError) as exc:
        _fail(f"repository post-receive hook is invalid: {hook}: {exc}")
    if hook_target != expected_hook.resolve(strict=True):
        _fail(f"repository post-receive hook target is invalid: {hook}")
    hook_info = _require_regular(expected_hook, "managed post-receive hook")
    if (hook_info.st_uid, hook_info.st_gid) != managed_hook_owner:
        _fail(
            "repository managed post-receive hook ownership is invalid: "
            f"{expected_hook}: {hook_info.st_uid}:{hook_info.st_gid}, "
            f"expected {managed_hook_owner[0]}:{managed_hook_owner[1]}"
        )
    if not hook_info.st_mode & stat.S_IXUSR or stat.S_IMODE(hook_info.st_mode) & 0o022:
        _fail(f"repository managed post-receive hook permissions are invalid: {expected_hook}")

    refs_owner = owner
    kilnr = path / "refs" / "kilnr"
    if _lexists(kilnr):
        kilnr_facts = _record_facts(
            facts,
            kilnr,
            "repository Kilnr refs",
            expected_mode=0o770,
            expected_owner=refs_owner,
            require_directory=True,
        )
        _validate_kilnr_ref_acl(kilnr, kilnr_facts, kilnr_acl_uid)
        jobs = kilnr / "jobs"
        if _lexists(jobs):
            jobs_facts = _record_facts(
                facts,
                jobs,
                "repository Kilnr job refs",
                expected_mode=0o770,
                expected_owner=refs_owner,
                require_directory=True,
            )
            _validate_kilnr_ref_acl(jobs, jobs_facts, kilnr_acl_uid)
    return owner


def _validate_secret_directory(path, facts, *, owner, enforce_metadata_acl=False):
    directory_facts = _record_facts(
        facts,
        path,
        "source secret directory",
        expected_mode=0o750,
        expected_owner=owner,
        require_directory=True,
    )
    secret_owner = (directory_facts.uid, directory_facts.gid)
    metadata_names = set()
    value_names = set()
    for entry in path.iterdir():
        if entry.is_symlink():
            _fail(f"secret entry is a symlink: {entry}")
        info = entry.lstat()
        if not stat.S_ISREG(info.st_mode):
            _fail(f"unexpected secret entry type: {entry}")
        if entry.suffix == ".json":
            name = entry.stem
            if not SECRET_NAME_RE.fullmatch(name) or name.startswith("KILNR_"):
                _fail(f"invalid secret name: {name!r}")
            metadata_facts = _record_facts(
                facts,
                entry,
                "secret metadata",
                expected_mode=0o640,
                expected_owner=secret_owner,
                require_regular=True,
            )
            if enforce_metadata_acl:
                _validate_no_extra_metadata_writers(entry, metadata_facts)
            metadata = _read_json(entry, "secret metadata")
            if (
                metadata.get("schema") != 1
                or metadata.get("scope") != "release"
                or metadata.get("kind") not in ("text", "file")
            ):
                _fail(f"invalid secret metadata: {entry}")
            metadata_names.add(name)
        elif entry.suffix == ".value":
            if not SECRET_NAME_RE.fullmatch(entry.stem) or entry.stem.startswith("KILNR_"):
                _fail(f"invalid secret name: {entry.stem!r}")
            value_facts = _record_facts(
                facts,
                entry,
                "secret value",
                expected_mode=0o640,
                expected_owner=secret_owner,
                require_regular=True,
            )
            if enforce_metadata_acl:
                _validate_no_extra_metadata_writers(entry, value_facts)
            value_names.add(entry.stem)
        else:
            _fail(f"unexpected secret entry: {entry}")
    if metadata_names != value_names:
        _fail(f"secret value/metadata mismatch: {path}")


def _validate_active_queues(roots, old):
    for queue_name in ("incoming", "running"):
        queue = roots.state / "queue" / queue_name
        _require_directory(queue, f"{queue_name} queue")
        for path in queue.iterdir():
            if path.is_symlink():
                _fail(f"queue entry is a symlink: {path}")
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode):
                _fail(f"queue entry is not a regular file: {path}")
            if path.suffix != ".json":
                _fail(f"unexpected queue entry: {path}")
            job = _read_json(path, f"{queue_name} queue job")
            required = {
                "schema", "id", "project", "received_at", "old_sha", "new_sha",
                "sha", "ref", "type", "pin_ref",
            }
            if required - set(job) or job.get("schema") != 1:
                _fail(f"invalid {queue_name} queue job schema: {path}")
            if path.name != f"{job.get('id')}.json":
                _fail(f"invalid {queue_name} queue job filename: {path}")
            project = job.get("project")
            try:
                validate_project_name(project)
            except ValueError:
                _fail(f"invalid project in {queue_name} queue job: {path}")
            for field in ("old_sha", "new_sha", "sha"):
                if not isinstance(job.get(field), str) or not OID_RE.fullmatch(job[field]):
                    _fail(f"invalid {field} in {queue_name} queue job: {path}")
            if job.get("pin_ref") != f"refs/kilnr/jobs/{job.get('id')}":
                _fail(f"invalid pin ref in {queue_name} queue job: {path}")
            if job.get("type") not in ("ci", "release"):
                _fail(f"invalid type in {queue_name} queue job: {path}")
            if project == old:
                _fail(f"active {queue_name} job for source project: {path}")


def _read_packed_refs(repository):
    path = repository / "packed-refs"
    if not _lexists(path):
        return {}
    raw = _read_regular_bytes(path, "repository packed refs", limit=MAX_JSON_BYTES)
    try:
        text = raw.decode("ascii")
    except UnicodeDecodeError as exc:
        _fail(f"invalid repository packed refs {path}: {exc}")
    result = {}
    for line_number, line in enumerate(text.splitlines(), start=1):
        if not line or line.startswith("#") or line.startswith("^"):
            continue
        fields = line.split(" ")
        if len(fields) != 2 or not OID_RE.fullmatch(fields[0]) or not fields[1].startswith("refs/"):
            _fail(f"invalid repository packed ref at {path}:{line_number}")
        if fields[1] in result:
            _fail(f"duplicate repository packed ref at {path}:{line_number}")
        result[fields[1]] = fields[0]
    return result


def _open_optional_directory(name, *, parent_fd, description):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        return os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            _fail(f"{description} is a symlink or not a directory")
        _fail(f"cannot open {description}: {exc}")


def _read_ref_at(parent_fd, name, display_path):
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(name, flags, dir_fd=parent_fd)
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            _fail(f"managed pin ref is a symlink: {display_path}")
        _fail(f"cannot open managed pin ref {display_path}: {exc}")
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            _fail(f"managed pin ref is not a regular file: {display_path}")
        if info.st_size > 256:
            _fail(f"managed pin ref is too large: {display_path}")
        raw = os.read(fd, 257)
    finally:
        os.close(fd)
    try:
        target = raw.decode("ascii").strip()
    except UnicodeDecodeError:
        _fail(f"invalid managed pin ref target: {display_path}")
    if not OID_RE.fullmatch(target):
        _fail(f"invalid managed pin ref target: {display_path}")
    return target


def _read_loose_job_refs(repository):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    repository_fd = os.open(repository, flags)
    refs_fd = None
    kilnr_fd = None
    jobs_fd = None
    try:
        refs_fd = _open_optional_directory(
            "refs", parent_fd=repository_fd, description="repository refs"
        )
        if refs_fd is None:
            _fail("repository refs missing")
        kilnr_fd = _open_optional_directory(
            "kilnr", parent_fd=refs_fd, description="repository Kilnr refs"
        )
        if kilnr_fd is None:
            return {}
        jobs_fd = _open_optional_directory(
            "jobs", parent_fd=kilnr_fd, description="repository Kilnr job refs"
        )
        if jobs_fd is None:
            return {}
        result = {}
        with os.scandir(jobs_fd) as entries:
            for entry in entries:
                display_path = repository / "refs" / "kilnr" / "jobs" / entry.name
                if entry.is_symlink():
                    _fail(f"managed pin ref is a symlink: {display_path}")
                if not entry.is_file(follow_symlinks=False):
                    _fail(f"managed pin ref is not a regular file: {display_path}")
                ref = f"refs/kilnr/jobs/{entry.name}"
                if ref in result:
                    _fail(f"duplicate loose managed pin ref: {ref}")
                result[ref] = _read_ref_at(jobs_fd, entry.name, display_path)
        return result
    finally:
        for fd in (jobs_fd, kilnr_fd, refs_fd, repository_fd):
            if fd is not None:
                os.close(fd)


def _timestamp_from_job(job, path):
    received_at = job.get("received_at")
    if not isinstance(received_at, str):
        _fail(f"invalid build received_at: {path}")
    try:
        parsed = datetime.fromisoformat(received_at.replace("Z", "+00:00"))
    except ValueError:
        _fail(f"invalid build received_at: {path}")
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        _fail(f"invalid build received_at timezone: {path}")
    parsed = parsed.astimezone(timezone.utc)
    return parsed.strftime("%Y%m%dT%H%M%S%fZ")


def _map_build_id(job, build_dir, old, new):
    old_id = job.get("id")
    if not isinstance(old_id, str) or old_id != build_dir.name:
        _fail(f"invalid build id/dirname mismatch: {build_dir}")
    sha = job.get("sha")
    if not isinstance(sha, str) or not OID_RE.fullmatch(sha):
        _fail(f"invalid build sha: {build_dir}")
    timestamp = _timestamp_from_job(job, build_dir / "job.json")
    prefix = f"{timestamp}-{old}-{sha[:7]}-"
    if not old_id.startswith(prefix):
        _fail(f"invalid build id for structured metadata: {old_id}")
    suffix = old_id[len(prefix):]
    if not BUILD_SUFFIX_RE.fullmatch(suffix):
        _fail(f"invalid build id random suffix: {old_id}")
    return f"{timestamp}-{new}-{sha[:7]}-{suffix}"


def _validate_job_schema(job, build_dir, old):
    required = {
        "schema",
        "id",
        "project",
        "received_at",
        "old_sha",
        "new_sha",
        "sha",
        "ref",
        "type",
        "pin_ref",
    }
    missing = required - set(job)
    if missing:
        _fail(f"build job metadata missing {', '.join(sorted(missing))}: {build_dir}")
    if job.get("schema") != 1 or job.get("project") != old:
        _fail(f"invalid source build job metadata: {build_dir}")
    for field in ("old_sha", "new_sha", "sha"):
        if not isinstance(job.get(field), str) or not OID_RE.fullmatch(job[field]):
            _fail(f"invalid build job {field}: {build_dir}")
    if not isinstance(job.get("ref"), str) or not job["ref"].startswith("refs/"):
        _fail(f"invalid build job ref: {build_dir}")
    if job.get("type") not in ("ci", "release"):
        _fail(f"invalid build job type: {build_dir}")
    event = job.get("event")
    if event is not None and event not in ("push", "pull_request", "tag"):
        _fail(f"invalid build job event: {build_dir}")
    if job["type"] == "ci":
        branch = job.get("branch")
        if branch is None and job["ref"].startswith("refs/heads/"):
            branch = job["ref"][len("refs/heads/"):]
        if (
            not isinstance(branch, str)
            or not branch
            or len(branch) > 255
            or "\x00" in branch
        ):
            _fail(f"invalid build job branch: {build_dir}")
    elif job["type"] == "release":
        tag = job.get("tag")
        if tag is None and job["ref"].startswith("refs/tags/"):
            tag = job["ref"][len("refs/tags/"):]
        if (
            not isinstance(tag, str)
            or not tag
            or len(tag) > 255
            or "\x00" in tag
        ):
            _fail(f"invalid build job tag: {build_dir}")
    _timestamp_from_job(job, build_dir / "job.json")


def _validate_runtime_schema(runtime, runtime_path, job):
    required = {
        "schema",
        "build_id",
        "project",
        "sha",
        "ref",
        "job_type",
        "pipeline",
        "max_parallel",
        "runner",
        "groups",
        "jobs",
    }
    missing = required - set(runtime)
    if missing:
        _fail(f"build runtime metadata missing {', '.join(sorted(missing))}: {runtime_path}")
    if runtime.get("job_type") != job.get("type") or runtime.get("ref") != job.get(
        "ref"
    ):
        _fail(f"inconsistent build runtime job identity: {runtime_path}")
    pipeline = runtime.get("pipeline")
    if not isinstance(pipeline, str):
        _fail(f"invalid build runtime pipeline: {runtime_path}")
    pipeline_path = PurePosixPath(pipeline)
    if (
        pipeline_path.is_absolute()
        or ".." in pipeline_path.parts
        or not pipeline.endswith(".json")
    ):
        _fail(f"invalid build runtime pipeline: {runtime_path}")
    if (
        not isinstance(runtime.get("max_parallel"), int)
        or isinstance(runtime.get("max_parallel"), bool)
        or runtime["max_parallel"] < 1
    ):
        _fail(f"invalid build runtime max_parallel: {runtime_path}")
    runner = runtime.get("runner")
    if not isinstance(runner, dict) or set(runner) != {
        "cpus", "memory", "pids_limit", "timeout_seconds"
    }:
        _fail(f"invalid build runtime runner: {runtime_path}")
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?", str(runner.get("cpus", ""))):
        _fail(f"invalid build runtime runner.cpus: {runtime_path}")
    if not re.fullmatch(r"[0-9]+[kKmMgG]", str(runner.get("memory", ""))):
        _fail(f"invalid build runtime runner.memory: {runtime_path}")
    if (
        not isinstance(runner.get("pids_limit"), int)
        or isinstance(runner.get("pids_limit"), bool)
        or not 16 <= runner["pids_limit"] <= 65535
    ):
        _fail(f"invalid build runtime runner.pids_limit: {runtime_path}")
    if (
        not isinstance(runner.get("timeout_seconds"), int)
        or isinstance(runner.get("timeout_seconds"), bool)
        or not 1 <= runner["timeout_seconds"] <= 86400
    ):
        _fail(f"invalid build runtime runner.timeout_seconds: {runtime_path}")
    if not isinstance(runtime.get("groups"), dict):
        _fail(f"invalid build runtime groups: {runtime_path}")
    jobs = runtime.get("jobs")
    if not isinstance(jobs, dict) or not jobs:
        _fail(f"invalid build runtime jobs: {runtime_path}")
    for job_id, spec in jobs.items():
        if (
            not isinstance(job_id, str)
            or not job_id
            or not isinstance(spec, dict)
            or not isinstance(spec.get("resolved_needs"), list)
            or any(not isinstance(dep, str) or not dep for dep in spec["resolved_needs"])
        ):
            _fail(f"invalid build runtime job {job_id!r}: {runtime_path}")


def _validate_status_schema(status_data, status_path, job):
    required = {
        "schema",
        "build_id",
        "job_id",
        "project",
        "sha",
        "ref",
        "type",
        "received_at",
        "prepare",
        "state",
        "pipeline",
    }
    missing = required - set(status_data)
    if missing:
        _fail(f"build status metadata missing {', '.join(sorted(missing))}: {status_path}")
    pipeline = status_data.get("pipeline")
    prepare = status_data.get("prepare")
    if (
        status_data.get("ref") != job.get("ref")
        or status_data.get("type") != job.get("type")
        or status_data.get("received_at") != job.get("received_at")
        or status_data.get("state") not in ("success", "failed", "aborted")
        or not isinstance(prepare, dict)
        or (pipeline is not None and not isinstance(pipeline, dict))
    ):
        _fail(f"inconsistent build status metadata: {status_path}")
    if pipeline is None and (
        status_data.get("state") != "failed" or prepare.get("state") != "failed"
    ):
        _fail(f"inconsistent terminal preparation failure: {status_path}")


def _validate_source_build(
    build_dir,
    job,
    old,
    new,
    facts,
    build_owner,
    *,
    allowed_top_level=(),
    enforce_metadata_acl=False,
):
    _validate_job_schema(job, build_dir, old)
    new_id = _map_build_id(job, build_dir, old, new)
    old_id = build_dir.name
    if job.get("pin_ref") != f"refs/kilnr/jobs/{old_id}":
        _fail(f"invalid source build pin ref: {build_dir}")

    runtime_path = build_dir / "runtime.json"
    status_path = build_dir / "status.json"
    pipeline_path = build_dir / "pipeline.mk"
    required_entries = {
        "job.json",
        "status.json",
        "src",
        "work",
        "logs",
        "artifacts",
        "commands",
    }
    optional_entries = {"runtime.json", "pipeline.mk", "runtime", "status.lock"}
    actual_entries = {entry.name for entry in build_dir.iterdir()}
    missing_entries = required_entries - actual_entries
    if missing_entries:
        _fail(
            "managed build entries missing "
            f"{', '.join(sorted(missing_entries))}: {build_dir}"
        )
    unexpected_entries = (
        actual_entries
        - required_entries
        - optional_entries
        - set(allowed_top_level)
    )
    if unexpected_entries:
        _fail(
            "unexpected managed build entries "
            f"{', '.join(sorted(unexpected_entries))}: {build_dir}"
        )
    for path, description in (
        (build_dir / "job.json", "build job metadata"),
        (status_path, "build status metadata"),
    ):
        metadata_facts = _record_facts(
            facts,
            path,
            description,
            expected_mode=0o640,
            expected_owner=build_owner,
            require_regular=True,
        )
        if enforce_metadata_acl:
            _validate_no_extra_metadata_writers(path, metadata_facts)
    for name in ("src", "work", "logs", "artifacts", "commands"):
        _record_facts(
            facts,
            build_dir / name,
            f"build {name} directory",
            expected_mode=0o750,
            expected_owner=build_owner,
            require_directory=True,
        )
    if "runtime" in actual_entries:
        _record_facts(
            facts,
            build_dir / "runtime",
            "build runtime directory",
            expected_mode=0o750,
            expected_owner=build_owner,
            require_directory=True,
        )
    if "status.lock" in actual_entries:
        status_lock_facts = _record_facts(
            facts,
            build_dir / "status.lock",
            "build status lock",
            expected_mode=0o640,
            expected_owner=build_owner,
            require_regular=True,
        )
        if enforce_metadata_acl:
            _validate_no_extra_metadata_writers(
                build_dir / "status.lock", status_lock_facts
            )

    status_data = _read_json(status_path, "build status metadata")
    if (
        status_data.get("schema") != 1
        or status_data.get("build_id") != old_id
        or status_data.get("job_id") != old_id
        or status_data.get("project") != old
        or status_data.get("sha") != job.get("sha")
    ):
        _fail(f"inconsistent build status metadata: {status_path}")
    _validate_status_schema(status_data, status_path, job)

    runtime = None
    if "runtime.json" in actual_entries:
        runtime_facts = _record_facts(
            facts,
            runtime_path,
            "build runtime metadata",
            expected_mode=0o640,
            expected_owner=build_owner,
            require_regular=True,
        )
        if enforce_metadata_acl:
            _validate_no_extra_metadata_writers(runtime_path, runtime_facts)
        runtime = _read_json(runtime_path, "build runtime metadata")
        if (
            runtime.get("schema") != 1
            or runtime.get("build_id") != old_id
            or runtime.get("project") != old
            or runtime.get("sha") != job.get("sha")
        ):
            _fail(f"inconsistent build runtime metadata: {runtime_path}")
        _validate_runtime_schema(runtime, runtime_path, job)

    if "pipeline.mk" not in actual_entries:
        if isinstance(status_data.get("pipeline"), dict):
            _fail(f"completed pipeline is missing generated pipeline.mk: {build_dir}")
        return new_id, runtime, status_data, None
    if runtime is None:
        _fail(f"generated pipeline.mk has no runtime metadata: {pipeline_path}")
    pipeline_facts = _record_facts(
        facts,
        pipeline_path,
        "generated pipeline.mk",
        expected_mode=0o640,
        expected_owner=build_owner,
        require_regular=True,
    )
    if enforce_metadata_acl:
        _validate_no_extra_metadata_writers(pipeline_path, pipeline_facts)
    pipeline = _read_regular_bytes(
        pipeline_path,
        "generated pipeline.mk",
        limit=MAX_JSON_BYTES,
    )
    try:
        pipeline_text = pipeline.decode("utf-8")
    except UnicodeDecodeError as exc:
        _fail(f"invalid generated pipeline.mk {pipeline_path}: {exc}")
    jobs = runtime.get("jobs")
    if not isinstance(jobs, dict) or not jobs:
        _fail(f"invalid runtime jobs for pipeline.mk: {runtime_path}")
    rewritten_lines = []
    recipe_jobs = []
    for line in pipeline_text.splitlines(keepends=True):
        body = line[:-1] if line.endswith("\n") else line
        ending = "\n" if line.endswith("\n") else ""
        if not body.startswith(PIPELINE_RECIPE):
            rewritten_lines.append(line)
            continue
        try:
            arguments = shlex.split(body[len(PIPELINE_RECIPE):], posix=True)
        except ValueError as exc:
            _fail(f"invalid generated pipeline.mk {pipeline_path}: {exc}")
        if len(arguments) != 2 or arguments[0] != old_id or arguments[1] not in jobs:
            _fail(f"unexpected generated pipeline.mk entry: {pipeline_path}")
        recipe_jobs.append(arguments[1])
        rewritten_lines.append(
            PIPELINE_RECIPE
            + shlex.quote(new_id)
            + " "
            + shlex.quote(arguments[1])
            + ending
        )
    if sorted(recipe_jobs) != sorted(jobs):
        _fail(f"generated pipeline.mk jobs mismatch: {pipeline_path}")
    return new_id, runtime, status_data, "".join(rewritten_lines).encode("utf-8")


def _rewrite_path_keys(value, path_mapping):
    if isinstance(value, dict):
        result = {}
        for key, item in value.items():
            if key in MANAGED_PATH_KEYS and isinstance(item, str):
                result[key] = path_mapping.get(item, item)
            else:
                result[key] = _rewrite_path_keys(item, path_mapping)
        return result
    if isinstance(value, list):
        return [_rewrite_path_keys(item, path_mapping) for item in value]
    return value


def _rewrite_config(config, old, new, path_mapping):
    rewritten = _rewrite_path_keys(copy.deepcopy(config), path_mapping)
    rewritten["project"] = new
    return rewritten


def _rewrite_build_metadata(kind, data, old, new, old_id, new_id, path_mapping):
    rewritten = _rewrite_path_keys(copy.deepcopy(data), path_mapping)
    rewritten["project"] = new
    if kind == "job":
        rewritten["id"] = new_id
        rewritten["pin_ref"] = f"refs/kilnr/jobs/{new_id}"
    elif kind == "runtime":
        rewritten["build_id"] = new_id
    elif kind == "status":
        rewritten["build_id"] = new_id
        rewritten["job_id"] = new_id
    else:
        raise AssertionError(f"unknown metadata kind: {kind}")
    return rewritten


def inventory_rename(roots, old, new, *, _allowed_build_entries=()):
    if not isinstance(roots, Roots):
        _fail("roots must be a Roots instance")
    old = _validated_name(old)
    new = _validated_name(new)
    if old == new:
        _fail("old and new project names must be different")
    production = _production_policy(roots)
    _validate_roots(roots, production)
    source_facts = {}
    config_root_facts = _record_facts(
        source_facts, roots.config, "project config root", require_directory=True
    )
    secret_root_facts = _record_facts(
        source_facts, roots.secrets, "secret root", require_directory=True
    )
    build_root_facts = _record_facts(
        source_facts,
        roots.state / "builds",
        "build root",
        require_directory=True,
    )
    cache_root_facts = _record_facts(
        source_facts,
        roots.state / "cache",
        "cache root",
        require_directory=True,
    )

    repository = PathMove(roots.git / f"{old}.git", roots.git / f"{new}.git")
    config_file = PathMove(roots.config / f"{old}.json", roots.config / f"{new}.json")
    webhook = PathMove(
        roots.secrets / f"{old}.discord-webhook",
        roots.secrets / f"{new}.discord-webhook",
    )
    secret_directory = PathMove(roots.secrets / old, roots.secrets / new)
    old_cache = roots.state / "cache" / old
    new_cache = roots.state / "cache" / new

    kilnr_acl_uid = (
        _kilnr_acl_uid(roots) if production is None else production.kilnr[0]
    )
    repository_expected_owner = None if production is None else production.git
    kilnr_identity = None
    if production is not None:
        kilnr_identity = (production.kilnr[0], production.kilnr_groups)
    repository_owner = _validate_bare_repository(
        repository.source,
        source_facts,
        managed_hook_owner=(
            _managed_hook_owner(roots) if production is None else production.root
        ),
        managed_hook_path=_managed_hook_path(roots),
        kilnr_acl_uid=kilnr_acl_uid,
        expected_owner=repository_expected_owner,
        kilnr_identity=kilnr_identity,
    )
    config_owner = (
        (config_root_facts.uid, config_root_facts.gid)
        if production is None
        else production.root
    )
    secret_owner = (
        (secret_root_facts.uid, secret_root_facts.gid)
        if production is None
        else (production.root[0], production.kilnr[1])
    )
    build_owner = (
        (build_root_facts.uid, build_root_facts.gid)
        if production is None
        else production.kilnr
    )
    cache_owner = (
        (cache_root_facts.uid, cache_root_facts.gid)
        if production is None
        else production.kilnr
    )
    config_facts = _record_facts(
        source_facts,
        config_file.source,
        "source project config",
        expected_mode=0o644,
        expected_owner=config_owner,
        require_regular=True,
    )
    webhook_facts = _record_facts(
        source_facts,
        webhook.source,
        "source webhook secret",
        expected_mode=0o640,
        expected_owner=secret_owner,
        require_regular=True,
    )
    if production is not None:
        _validate_no_extra_metadata_writers(config_file.source, config_facts)
        _validate_no_extra_metadata_writers(webhook.source, webhook_facts)
    _validate_secret_directory(
        secret_directory.source,
        source_facts,
        owner=secret_owner,
        enforce_metadata_acl=production is not None,
    )
    if _lexists(old_cache):
        _record_facts(
            source_facts,
            old_cache,
            "source project cache",
            expected_mode=0o750,
            expected_owner=cache_owner,
            require_directory=True,
        )
        cache = PathMove(old_cache, new_cache)
    else:
        cache = None

    for move in (repository, config_file, webhook, secret_directory):
        _require_absent(move.destination)
        _require_same_filesystem(move)
    _require_absent(new_cache)
    if cache is not None:
        _require_same_filesystem(cache)

    config = _read_json(config_file.source, "source project config")
    _validate_config(config, config_file.source, old, repository.source, webhook.source)
    _validate_active_queues(roots, old)

    builds_root = roots.state / "builds"
    _require_directory(builds_root, "build root")
    allowed_build_entries = {}
    for path in _allowed_build_entries:
        candidate = Path(path)
        allowed_build_entries.setdefault(candidate.parent, set()).add(candidate.name)
    build_records = []
    build_ids = {}
    build_shas = {}
    destinations = set()
    for build_dir in sorted(builds_root.iterdir(), key=lambda item: item.name):
        if build_dir.is_symlink():
            _fail(f"build directory is a symlink: {build_dir}")
        info = build_dir.lstat()
        if not stat.S_ISDIR(info.st_mode):
            _fail(f"unexpected build root entry: {build_dir}")
        _record_facts(
            source_facts,
            build_dir,
            "completed build directory",
            expected_mode=0o750,
            expected_owner=build_owner,
            require_directory=True,
        )
        job_path = build_dir / "job.json"
        job = _read_json(job_path, "build job metadata")
        project = job.get("project")
        try:
            validate_project_name(project)
        except ValueError:
            _fail(f"invalid project in build job metadata: {job_path}")
        if project != old:
            continue
        new_id, runtime, status_data, pipeline_data = _validate_source_build(
            build_dir,
            job,
            old,
            new,
            source_facts,
            build_owner,
            allowed_top_level=allowed_build_entries.get(build_dir, ()),
            enforce_metadata_acl=production is not None,
        )
        if new_id in destinations:
            _fail(f"colliding destination build id: {new_id}")
        destinations.add(new_id)
        destination = builds_root / new_id
        _require_absent(destination)
        move = PathMove(build_dir, destination)
        _require_same_filesystem(move)
        build_ids[build_dir.name] = new_id
        build_shas[build_dir.name] = job["sha"]
        build_records.append(
            (move, job, runtime, status_data, pipeline_data)
        )

    pin_refs = {}
    packed_refs_path = repository.source / "packed-refs"
    if _lexists(packed_refs_path):
        _require_not_writable_by_group_or_other(
            source_facts,
            packed_refs_path,
            "repository packed refs",
            owner=repository_owner,
        )
        _require_regular(packed_refs_path, "repository packed refs")
    packed_refs = _read_packed_refs(repository.source)
    loose_refs = _read_loose_job_refs(repository.source)
    jobs_root = repository.source / "refs" / "kilnr" / "jobs"
    for ref in loose_refs:
        ref_path = jobs_root / ref[len("refs/kilnr/jobs/"):]
        ref_facts = _record_facts(
            source_facts,
            ref_path,
            "managed loose pin ref",
            expected_owner=repository_owner,
            require_regular=True,
        )
        _validate_kilnr_loose_ref_acl(ref_path, ref_facts, kilnr_acl_uid)
    managed_packed_refs = {
        ref: target
        for ref, target in packed_refs.items()
        if ref.startswith("refs/kilnr/jobs/")
    }
    old_refs = {
        f"refs/kilnr/jobs/{old_id}": (old_id, f"refs/kilnr/jobs/{new_id}")
        for old_id, new_id in build_ids.items()
    }
    destination_refs = {
        f"refs/kilnr/jobs/{new_id}" for new_id in build_ids.values()
    }
    for ref in sorted(set(loose_refs) | set(managed_packed_refs)):
        if ref in destination_refs:
            _fail(f"destination pin ref exists: {ref}")
        if ref not in old_refs:
            _fail(f"unmatched managed pin ref: {ref}")
        loose_target = loose_refs.get(ref)
        packed_target = managed_packed_refs.get(ref)
        if (
            loose_target is not None
            and packed_target is not None
            and loose_target != packed_target
        ):
            _fail(f"ambiguous managed pin ref: {ref}")
        source_target = loose_target if loose_target is not None else packed_target
        old_id, new_ref = old_refs[ref]
        if source_target != build_shas[old_id]:
            _fail(f"pin ref target mismatch: {ref}")
        pin_refs[ref] = new_ref

    path_mapping = {
        str(repository.source): str(repository.destination),
        str(config_file.source): str(config_file.destination),
        str(webhook.source): str(webhook.destination),
        str(secret_directory.source): str(secret_directory.destination),
        str(old_cache): str(new_cache),
    }
    for move in (record[0] for record in build_records):
        path_mapping[str(move.source)] = str(move.destination)

    metadata_writes = [
        MetadataWrite(
            source=config_file.source,
            destination=config_file.destination,
            data=_json_bytes(_rewrite_config(config, old, new, path_mapping)),
            is_json=True,
            stage_directory=config_file.destination.parent,
            facts=source_facts[config_file.source],
        )
    ]
    for move, job, runtime, status_data, pipeline_data in build_records:
        old_id = move.source.name
        new_id = move.destination.name
        for filename, kind, value in (
            ("job.json", "job", job),
            ("runtime.json", "runtime", runtime),
            ("status.json", "status", status_data),
        ):
            if value is None:
                continue
            metadata_writes.append(
                MetadataWrite(
                    source=move.source / filename,
                    destination=move.destination / filename,
                    data=_json_bytes(
                        _rewrite_build_metadata(
                            kind, value, old, new, old_id, new_id, path_mapping
                        )
                    ),
                    is_json=True,
                    stage_directory=move.source,
                    facts=source_facts[move.source / filename],
                )
            )
        if pipeline_data is not None:
            metadata_writes.append(
                MetadataWrite(
                    source=move.source / "pipeline.mk",
                    destination=move.destination / "pipeline.mk",
                    data=pipeline_data,
                    is_json=False,
                    stage_directory=move.source,
                    facts=source_facts[move.source / "pipeline.mk"],
                )
            )

    return RenameInventory(
        roots=roots,
        old=old,
        new=new,
        repository=repository,
        config_file=config_file,
        webhook=webhook,
        secret_directory=secret_directory,
        cache=cache,
        builds=tuple(record[0] for record in build_records),
        build_ids=build_ids,
        pin_refs=pin_refs,
        metadata_writes=tuple(metadata_writes),
        source_facts=source_facts,
    )


def _fsync_directory(path):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _prepare_write(write):
    source_info = _require_regular(write.source, "metadata source")
    current_source_facts = FileFacts(
        mode=stat.S_IMODE(source_info.st_mode),
        uid=source_info.st_uid,
        gid=source_info.st_gid,
        acl=_read_acl(write.source),
    )
    if current_source_facts != write.facts:
        _fail(f"metadata source permissions changed after inventory: {write.source}")
    _require_directory(write.stage_directory, "metadata staging directory")
    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{write.destination.name}.",
        suffix=".rename-tmp",
        dir=write.stage_directory,
    )
    temporary = Path(temporary_name)
    try:
        current = os.fstat(fd)
        if (current.st_uid, current.st_gid) != (source_info.st_uid, source_info.st_gid):
            os.fchown(fd, source_info.st_uid, source_info.st_gid)
        for name, value in write.facts.acl:
            try:
                os.setxattr(fd, name, value)
            except (AttributeError, OSError) as exc:
                _fail(f"cannot preserve ACL {name!r} for {write.destination}: {exc}")
        os.fchmod(fd, stat.S_IMODE(source_info.st_mode))
        view = memoryview(write.data)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                _fail(f"short write while preparing metadata: {write.destination}")
            view = view[written:]
        os.fsync(fd)
    except Exception:
        os.close(fd)
        temporary.unlink(missing_ok=True)
        raise
    else:
        os.close(fd)

    try:
        if write.is_json:
            prepared_json = _read_json(temporary, "prepared metadata")
            if _json_bytes(prepared_json) != write.data:
                _fail(f"prepared JSON validation changed content: {temporary}")
        elif _read_regular_bytes(temporary, "prepared metadata") != write.data:
            _fail(f"prepared metadata validation changed content: {temporary}")
        prepared_info = temporary.lstat()
        prepared_facts = FileFacts(
            mode=stat.S_IMODE(prepared_info.st_mode),
            uid=prepared_info.st_uid,
            gid=prepared_info.st_gid,
            acl=_read_acl(temporary),
        )
        if prepared_facts != write.facts:
            _fail(f"prepared metadata permissions do not match source: {temporary}")
        _fsync_directory(write.stage_directory)
        return PreparedFile(write=write, temporary=temporary)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


def prepare_rename(inventory):
    if not isinstance(inventory, RenameInventory):
        _fail("inventory must be a RenameInventory instance")
    prepared = []
    try:
        for write in inventory.metadata_writes:
            prepared.append(_prepare_write(write))
    except Exception:
        PreparedRename(inventory=inventory, files=tuple(prepared)).cleanup()
        raise
    return PreparedRename(inventory=inventory, files=tuple(prepared))


class _Operation:
    label = ""

    def apply(self):
        raise NotImplementedError

    def rollback(self):
        raise NotImplementedError

    def describe(self):
        raise NotImplementedError

    def fsync_after_apply(self):
        return None

    def fsync_after_rollback(self):
        return None

    def diagnostic_paths(self):
        return ()


class _ReplaceOperation(_Operation):
    def __init__(self, source, destination, label):
        self.source = Path(source)
        self.destination = Path(destination)
        self.label = label

    def apply(self):
        _lstat(self.source, "transaction source")
        _require_absent(self.destination, "transaction destination")
        os.replace(self.source, self.destination)

    def rollback(self):
        _lstat(self.destination, "rollback source")
        _require_absent(self.source, "rollback destination")
        os.replace(self.destination, self.source)

    def describe(self):
        return f"{self.source} <- {self.destination}"

    def _fsync_parents(self):
        parents = {self.source.parent, self.destination.parent}
        for parent in sorted(parents, key=str):
            _fsync_directory(parent)

    def fsync_after_apply(self):
        self._fsync_parents()

    def fsync_after_rollback(self):
        self._fsync_parents()

    def diagnostic_paths(self):
        return (self.source, self.destination)


def _hardened_git_environment():
    return {
        "HOME": "/nonexistent",
        "PATH": "/usr/bin:/bin",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
    }


def _hardened_git_command(repository, *arguments):
    repository = Path(repository)
    return [
        "/usr/bin/git",
        "-c",
        "core.hooksPath=/dev/null",
        "-c",
        f"safe.directory={repository}",
        f"--git-dir={repository}",
        *arguments,
    ]


def _git_ref_value(repository, ref):
    result = subprocess.run(
        _hardened_git_command(repository, "rev-parse", "--verify", "--quiet", ref),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        env=_hardened_git_environment(),
    )
    if result.returncode == 1:
        return None
    if result.returncode != 0:
        detail = result.stderr.strip() or f"git exited {result.returncode}"
        _fail(f"cannot inspect Git ref {ref} in {repository}: {detail}")
    oid = result.stdout.strip()
    if not OID_RE.fullmatch(oid):
        _fail(f"invalid Git ref target for {ref} in {repository}")
    return oid


def _git_update_ref_transaction(repository, commands):
    lines = ["start"]
    lines.extend(commands)
    lines.extend(("prepare", "commit", ""))
    result = subprocess.run(
        _hardened_git_command(repository, "update-ref", "--stdin"),
        input="\n".join(lines),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        env=_hardened_git_environment(),
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or f"git exited {result.returncode}"
        _fail(f"Git ref transaction failed in {repository}: {detail}")


def _restore_path_facts(path, facts, *, require_directory):
    flags = os.O_RDONLY | os.O_CLOEXEC
    if require_directory:
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if require_directory and not stat.S_ISDIR(info.st_mode):
            _fail(f"managed ref namespace is not a directory: {path}")
        if not require_directory and not stat.S_ISREG(info.st_mode):
            _fail(f"managed ref is not a regular file: {path}")
        if (info.st_uid, info.st_gid) != (facts.uid, facts.gid):
            os.fchown(fd, facts.uid, facts.gid)
        for name, value in facts.acl:
            try:
                os.setxattr(fd, name, value)
            except (AttributeError, OSError) as exc:
                _fail(f"cannot restore ACL {name!r} for {path}: {exc}")
        os.fchmod(fd, facts.mode)
        restored_info = os.fstat(fd)
        restored_facts = FileFacts(
            mode=stat.S_IMODE(restored_info.st_mode),
            uid=restored_info.st_uid,
            gid=restored_info.st_gid,
            acl=_read_acl(path),
        )
        if restored_facts != facts:
            _fail(
                f"restored snapshot permissions do not match source: {path}: "
                f"found {restored_facts!r}, expected {facts!r}"
            )
        os.fsync(fd)
    finally:
        os.close(fd)


def _restore_file_facts(path, facts):
    _restore_path_facts(path, facts, require_directory=False)


def _restore_directory_facts(path, facts):
    _restore_path_facts(path, facts, require_directory=True)


def _restore_regular_snapshot(path, data, facts):
    path = Path(path)
    _require_directory(path.parent, "snapshot restore parent")
    if _lexists(path):
        _require_regular(path, "snapshot restore destination")
    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        suffix=".rename-rollback",
        dir=path.parent,
    )
    temporary = Path(temporary_name)
    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                _fail(f"short write while restoring {path}")
            view = view[written:]
        current = os.fstat(fd)
        if (current.st_uid, current.st_gid) != (facts.uid, facts.gid):
            os.fchown(fd, facts.uid, facts.gid)
        expected_acl = {name: value for name, value in facts.acl}
        if hasattr(os, "listxattr") and hasattr(os, "removexattr"):
            try:
                names = os.listxattr(fd)
            except OSError as exc:
                if exc.errno not in (errno.ENOTSUP, errno.EOPNOTSUPP):
                    raise
                names = ()
            for name in names:
                normalized = os.fsdecode(name)
                if "acl" in normalized.lower() and normalized not in expected_acl:
                    os.removexattr(fd, name)
        for name, value in facts.acl:
            try:
                os.setxattr(fd, name, value)
            except (AttributeError, OSError) as exc:
                _fail(f"cannot restore ACL {name!r} for {path}: {exc}")
        os.fchmod(fd, facts.mode)
        restored_info = os.fstat(fd)
        restored_facts = FileFacts(
            mode=stat.S_IMODE(restored_info.st_mode),
            uid=restored_info.st_uid,
            gid=restored_info.st_gid,
            acl=_read_acl(temporary),
        )
        if restored_facts != facts:
            _fail(
                f"restored snapshot permissions do not match source: {path}: "
                f"found {restored_facts!r}, expected {facts!r}"
            )
        os.fsync(fd)
        os.close(fd)
        fd = None
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    except BaseException:
        if fd is not None:
            os.close(fd)
        temporary.unlink(missing_ok=True)
        raise


def _expected_ref_directory_facts(roots, repository, source_facts):
    for path in (
        repository / "refs" / "kilnr" / "jobs",
        repository / "refs" / "kilnr",
    ):
        facts = source_facts.get(path)
        if facts is not None:
            return facts
    repository_facts = source_facts[repository]
    acl = ()
    if roots == DEFAULT_ROOTS:
        uid = _kilnr_acl_uid(roots)
        value = struct.pack("<I", 2) + b"".join(
            struct.pack("<HHI", tag, permissions, entry_id)
            for tag, permissions, entry_id in (
                (0x01, 0o7, 0xFFFFFFFF),
                (0x02, 0o7, uid),
                (0x04, 0o5, 0xFFFFFFFF),
                (0x10, 0o7, 0xFFFFFFFF),
                (0x20, 0o0, 0xFFFFFFFF),
            )
        )
        acl = (
            ("system.posix_acl_access", value),
            ("system.posix_acl_default", value),
        )
    return FileFacts(
        mode=0o770,
        uid=repository_facts.uid,
        gid=repository_facts.gid,
        acl=acl,
    )


def _expected_loose_ref_facts(repository, source_facts, namespace_facts):
    jobs = repository / "refs" / "kilnr" / "jobs"
    captured = sorted(
        (
            (path, facts)
            for path, facts in source_facts.items()
            if Path(path).parent == jobs
        ),
        key=lambda item: str(item[0]),
    )
    if captured:
        return captured[0][1]

    default_acl = dict(namespace_facts.acl).get("system.posix_acl_default")
    repository_facts = source_facts[repository]
    if default_acl is None:
        return FileFacts(
            mode=0o640,
            uid=repository_facts.uid,
            gid=repository_facts.gid,
            acl=(),
        )

    entries = _decode_posix_acl(
        default_acl,
        jobs,
        "system.posix_acl_default",
    )
    file_entries = tuple(
        (
            tag,
            permissions & 0o6 if tag in (0x01, 0x10, 0x20) else permissions,
            entry_id,
        )
        for tag, permissions, entry_id in entries
    )
    permissions_by_tag = {
        tag: permissions
        for tag, permissions, _entry_id in file_entries
        if tag in (0x01, 0x10, 0x20)
    }
    if set(permissions_by_tag) != {0x01, 0x10, 0x20}:
        _fail(f"repository Kilnr ref default ACL policy is invalid for {jobs}")
    access_acl = struct.pack("<I", 2) + b"".join(
        struct.pack("<HHI", tag, permissions, entry_id)
        for tag, permissions, entry_id in file_entries
    )
    mode = (
        permissions_by_tag[0x01] << 6
        | permissions_by_tag[0x10] << 3
        | permissions_by_tag[0x20]
    )
    return FileFacts(
        mode=mode,
        uid=repository_facts.uid,
        gid=repository_facts.gid,
        acl=(("system.posix_acl_access", access_acl),),
    )


class _RefRenameOperation(_Operation):
    label = "pin-refs"

    def __init__(
        self, repository, source_repository, pin_refs, source_facts, roots
    ):
        self.repository = Path(repository)
        self.source_repository = Path(source_repository)
        self.namespace_facts = _expected_ref_directory_facts(
            roots, self.source_repository, source_facts
        )
        self.loose_ref_facts = _expected_loose_ref_facts(
            self.source_repository,
            source_facts,
            self.namespace_facts,
        )
        self.source_namespace_facts = {
            relative: source_facts.get(self.source_repository / relative)
            for relative in (
                Path("refs") / "kilnr",
                Path("refs") / "kilnr" / "jobs",
            )
        }
        self.pin_refs = tuple(sorted(pin_refs.items()))
        self.targets = {}
        self.source_ref_facts = {}
        self.destination_facts = {}
        packed_facts = source_facts.get(
            self.source_repository / "packed-refs"
        )
        packed_refs = _read_packed_refs(self.repository)
        self.packed_facts = packed_facts
        self.packed_data = (
            _read_regular_bytes(
                self.repository / "packed-refs",
                "repository packed refs",
                limit=MAX_JSON_BYTES,
            )
            if packed_facts is not None
            else None
        )
        self.packed_only_refs = []
        self.packed_and_loose_refs = []
        for old_ref, new_ref in self.pin_refs:
            target = _git_ref_value(self.repository, old_ref)
            if target is None:
                _fail(f"source pin ref disappeared: {old_ref} in {self.repository}")
            if _git_ref_value(self.repository, new_ref) is not None:
                _fail(f"destination pin ref exists: {new_ref} in {self.repository}")
            self.targets[old_ref] = target
            loose_path = self.source_repository / old_ref
            facts = source_facts.get(loose_path)
            if old_ref in packed_refs:
                if facts is None:
                    self.packed_only_refs.append(old_ref)
                else:
                    self.packed_and_loose_refs.append(old_ref)
            if facts is None:
                if packed_facts is not None:
                    source_ref_facts = packed_facts
                else:
                    source_ref_facts = self.loose_ref_facts
                destination_facts = self.loose_ref_facts
            else:
                source_ref_facts = facts
                destination_facts = facts
            self.source_ref_facts[old_ref] = source_ref_facts
            self.destination_facts[new_ref] = destination_facts

    def apply(self):
        commands = []
        for old_ref, new_ref in self.pin_refs:
            target = self.targets[old_ref]
            commands.append(f"create {new_ref} {target}")
            commands.append(f"delete {old_ref} {target}")
        _git_update_ref_transaction(self.repository, commands)

    def secure_namespace(self):
        for path in (
            self.repository / "refs" / "kilnr",
            self.repository / "refs" / "kilnr" / "jobs",
        ):
            _restore_directory_facts(path, self.namespace_facts)

    def secure_destination_refs(self):
        for new_ref, facts in self.destination_facts.items():
            _restore_file_facts(self.repository / new_ref, facts)

    def restore_packed_ref_facts(self):
        packed_refs_path = self.repository / "packed-refs"
        if self.packed_facts is not None and _lexists(packed_refs_path):
            _restore_file_facts(packed_refs_path, self.packed_facts)

    def restore_packed_ref_snapshot(self):
        packed_refs_path = self.repository / "packed-refs"
        if self.packed_facts is None:
            if _lexists(packed_refs_path):
                _require_regular(packed_refs_path, "rollback packed refs")
                packed_refs_path.unlink()
                _fsync_directory(self.repository)
            return
        if self.packed_data is None:
            _fail(f"missing rollback packed-ref snapshot for {self.repository}")
        _restore_regular_snapshot(
            packed_refs_path,
            self.packed_data,
            self.packed_facts,
        )

    def remove_rollback_only_loose_refs(self):
        parents = set()
        for ref in self.packed_only_refs:
            path = self.repository / ref
            _require_regular(path, "rollback-only loose ref")
            try:
                value = path.read_text(encoding="ascii").strip()
            except (OSError, UnicodeDecodeError) as exc:
                _fail(f"cannot inspect rollback-only loose ref {path}: {exc}")
            if value != self.targets[ref]:
                _fail(f"rollback-only loose ref has unexpected target: {path}")
            path.unlink()
            parents.add(path.parent)
        for parent in sorted(parents, key=str):
            _fsync_directory(parent)

    def restore_source_namespace(self):
        for relative in (
            Path("refs") / "kilnr" / "jobs",
            Path("refs") / "kilnr",
        ):
            path = self.repository / relative
            facts = self.source_namespace_facts[relative]
            if facts is not None:
                _restore_directory_facts(path, facts)
                continue
            if not _lexists(path):
                continue
            info = _lstat(path, "rollback ref namespace")
            if not stat.S_ISDIR(info.st_mode):
                _fail(f"rollback ref namespace is not a directory: {path}")
            try:
                path.rmdir()
                _fsync_directory(path.parent)
            except OSError as exc:
                _fail(f"cannot remove rollback-only ref namespace {path}: {exc}")

    def rollback(self):
        commands = []
        for old_ref, new_ref in self.pin_refs:
            target = self.targets[old_ref]
            commands.append(f"create {old_ref} {target}")
            commands.append(f"delete {new_ref} {target}")
        _git_update_ref_transaction(self.repository, commands)
        _fsync_directory(self.repository)
        for old_ref, facts in self.source_ref_facts.items():
            if old_ref in self.packed_only_refs:
                continue
            _restore_file_facts(self.repository / old_ref, facts)
        self.restore_packed_ref_snapshot()
        self.remove_rollback_only_loose_refs()
        self.restore_source_namespace()

    def describe(self):
        refs = ", ".join(f"{old} <- {new}" for old, new in self.pin_refs)
        return f"{self.repository}: {refs}"

    def fsync_after_apply(self):
        _fsync_directory(self.repository)

    def fsync_after_rollback(self):
        _fsync_directory(self.repository)

    def diagnostic_paths(self):
        return (self.repository, self.source_repository)


def _validate_prepared_rename(prepared):
    if not isinstance(prepared, PreparedRename):
        _fail("prepared must be a PreparedRename instance")
    inventory = prepared.inventory
    current = inventory_rename(
        inventory.roots,
        inventory.old,
        inventory.new,
        _allowed_build_entries=tuple(item.temporary for item in prepared.files),
    )
    if current != inventory:
        _fail("rename inventory changed after preparation")
    if len(prepared.files) != len(inventory.metadata_writes):
        _fail("prepared metadata set is incomplete")
    for item, write in zip(prepared.files, inventory.metadata_writes):
        if item.write != write:
            _fail(f"prepared metadata order mismatch: {write.destination}")
        info = _require_regular(item.temporary, "prepared metadata")
        facts = FileFacts(
            mode=stat.S_IMODE(info.st_mode),
            uid=info.st_uid,
            gid=info.st_gid,
            acl=_read_acl(item.temporary),
        )
        if facts != write.facts:
            _fail(f"prepared metadata permissions changed: {item.temporary}")
        if _read_regular_bytes(item.temporary, "prepared metadata") != write.data:
            _fail(f"prepared metadata content changed: {item.temporary}")


def _cleanup_prepared(prepared):
    failures = []
    parents = set()
    for item in prepared.files:
        for path in {item.temporary, item.temporary_after_moves}:
            try:
                path.unlink()
                parents.add(path.parent)
            except FileNotFoundError:
                pass
            except OSError as exc:
                failures.append(f"{path}: {exc}")
    for parent in sorted(parents, key=str):
        try:
            if parent.is_dir():
                _fsync_directory(parent)
        except OSError as exc:
            failures.append(f"{parent}: {exc}")
    return failures


def _failure_message(primary, rollback_failures, cleanup_failures):
    message = str(primary) or primary.__class__.__name__
    if rollback_failures:
        message += "\nrollback failed; administrator attention required:"
        for failure in rollback_failures:
            message += f"\n  {failure}"
    if cleanup_failures:
        message += "\ntemporary-file cleanup failed; administrator attention required:"
        for failure in cleanup_failures:
            message += f"\n  {failure}"
    return message


def _candidate_paths_after_rollback(path, inventory):
    candidates = {Path(path)}
    changed = True
    while changed:
        changed = False
        for candidate in tuple(candidates):
            for move in inventory.path_moves:
                for parent, replacement in (
                    (move.destination, move.source),
                    (move.source, move.destination),
                ):
                    try:
                        relative = candidate.relative_to(parent)
                    except ValueError:
                        continue
                    relocated = replacement / relative
                    if relocated not in candidates:
                        candidates.add(relocated)
                        changed = True
    return candidates


def _format_rollback_failure(operation, failure, inventory):
    candidates = set()
    for path in operation.diagnostic_paths():
        candidates.update(_candidate_paths_after_rollback(path, inventory))
    existing = sorted((path for path in candidates if _lexists(path)), key=str)
    if existing:
        location = ", ".join(str(path) for path in existing)
        return f"{operation.label} inverse failed at {location}: {failure}"
    return f"{operation.label} inverse failed after final relocation: {failure}"


def _reject_old_managed_paths(value, old_paths, metadata_path, location="$"):
    if isinstance(value, dict):
        for key, item in value.items():
            child_location = f"{location}.{key}"
            if (
                key in MANAGED_PATH_KEYS
                and isinstance(item, str)
                and item in old_paths
            ):
                _fail(
                    f"old managed path remains in {metadata_path} "
                    f"at {child_location}: {item}"
                )
            _reject_old_managed_paths(
                item, old_paths, metadata_path, child_location
            )
    elif isinstance(value, list):
        for index, item in enumerate(value):
            _reject_old_managed_paths(
                item, old_paths, metadata_path, f"{location}[{index}]"
            )


def verify_rename(
    roots: Roots,
    old: str,
    new: str,
    build_ids: Mapping[str, str],
    *,
    _allowed_build_entries=(),
) -> None:
    if not isinstance(roots, Roots):
        _fail("roots must be a Roots instance")
    old = _validated_name(old)
    new = _validated_name(new)
    if old == new:
        _fail("old and new project names must be different")
    if not isinstance(build_ids, Mapping):
        _fail("build_ids must be a mapping")
    expected_inverse = {}
    for old_id, new_id in build_ids.items():
        if not isinstance(old_id, str) or not isinstance(new_id, str):
            _fail("build_ids must map strings to strings")
        if new_id in expected_inverse:
            _fail(f"duplicate verified destination build id: {new_id}")
        expected_inverse[new_id] = old_id

    verified = inventory_rename(
        roots,
        new,
        old,
        _allowed_build_entries=_allowed_build_entries,
    )
    if verified.build_ids != expected_inverse:
        _fail(
            f"renamed build mapping mismatch under {roots.state / 'builds'}: "
            f"expected {expected_inverse!r}, found {verified.build_ids!r}"
        )
    old_paths = {
        str(roots.git / f"{old}.git"),
        str(roots.config / f"{old}.json"),
        str(roots.secrets / f"{old}.discord-webhook"),
        str(roots.secrets / old),
        str(roots.state / "cache" / old),
    }
    old_paths.update(
        str(roots.state / "builds" / old_id) for old_id in build_ids
    )
    config_path = roots.config / f"{new}.json"
    _reject_old_managed_paths(
        _read_json(config_path, "renamed project config"),
        old_paths,
        config_path,
    )
    for new_id in build_ids.values():
        build = roots.state / "builds" / new_id
        for filename in ("job.json", "status.json"):
            metadata_path = build / filename
            _reject_old_managed_paths(
                _read_json(metadata_path, "renamed build metadata"),
                old_paths,
                metadata_path,
            )
        runtime_path = build / "runtime.json"
        if _lexists(runtime_path):
            _reject_old_managed_paths(
                _read_json(runtime_path, "renamed build metadata"),
                old_paths,
                runtime_path,
            )


def commit_rename(
    prepared: PreparedRename,
    fault: Optional[Callable[[str], None]] = None,
) -> None:
    if not isinstance(prepared, PreparedRename):
        _fail("prepared must be a PreparedRename instance")
    rollback_stack = []
    backup_paths = []
    try:
        _validate_prepared_rename(prepared)
        inventory = prepared.inventory
        moves = (
            (inventory.repository, "repository-move"),
            (inventory.config_file, "config-move"),
            (inventory.webhook, "webhook-move"),
            (inventory.secret_directory, "secret-directory-move"),
        )
        if inventory.cache is not None:
            moves += ((inventory.cache, "cache-move"),)
        moves += tuple((move, "build-move") for move in inventory.builds)

        for move, label in moves:
            operation = _ReplaceOperation(move.source, move.destination, label)
            operation.apply()
            rollback_stack.append(operation)
            operation.fsync_after_apply()
            if fault is not None:
                fault(label)

        for item in prepared.files:
            temporary = item.temporary_after_moves
            destination = item.write.destination
            backup = destination.parent / (
                item.temporary.name + ".rename-rollback"
            )
            backup_operation = _ReplaceOperation(
                destination, backup, "metadata-backup"
            )
            backup_operation.apply()
            rollback_stack.append(backup_operation)
            backup_paths.append(backup)
            backup_operation.fsync_after_apply()
            if fault is not None:
                fault("metadata-backup")

            install_operation = _ReplaceOperation(
                temporary, destination, "metadata-install"
            )
            install_operation.apply()
            rollback_stack.append(install_operation)
            install_operation.fsync_after_apply()
            if fault is not None:
                fault("metadata-install")

        if inventory.pin_refs:
            ref_operation = _RefRenameOperation(
                inventory.repository.destination,
                inventory.repository.source,
                inventory.pin_refs,
                inventory.source_facts,
                inventory.roots,
            )
            ref_operation.apply()
            rollback_stack.append(ref_operation)
            ref_operation.fsync_after_apply()
            ref_operation.secure_namespace()
            ref_operation.secure_destination_refs()
            ref_operation.restore_packed_ref_facts()
            ref_operation.fsync_after_apply()
            if fault is not None:
                fault("pin-refs")

        verify_rename(
            inventory.roots,
            inventory.old,
            inventory.new,
            inventory.build_ids,
            _allowed_build_entries=tuple(backup_paths),
        )
        if inventory.pin_refs:
            for old_ref, new_ref in inventory.pin_refs.items():
                if _git_ref_value(inventory.repository.destination, old_ref) is not None:
                    _fail(
                        f"old pin ref remains in {inventory.repository.destination}: "
                        f"{old_ref}"
                    )
                actual = _git_ref_value(inventory.repository.destination, new_ref)
                expected = ref_operation.targets[old_ref]
                if actual != expected:
                    _fail(
                        f"renamed pin ref mismatch in {inventory.repository.destination}: "
                        f"{new_ref}: expected {expected}, found {actual}"
                    )
        if fault is not None:
            fault("verify")
    except BaseException as exc:
        rollback_failures = []
        for operation in reversed(rollback_stack):
            try:
                operation.rollback()
                operation.fsync_after_rollback()
            except BaseException as rollback_exc:
                rollback_failures.append((operation, rollback_exc))
        rollback_failures = [
            _format_rollback_failure(operation, failure, prepared.inventory)
            for operation, failure in rollback_failures
        ]
        cleanup_failures = _cleanup_prepared(prepared)
        raise RenameError(
            _failure_message(exc, rollback_failures, cleanup_failures)
        ) from None

    cleanup_failures = []
    for path in backup_paths:
        try:
            path.unlink()
            _fsync_directory(path.parent)
        except OSError as exc:
            cleanup_failures.append(f"{path}: {exc}")
    cleanup_failures.extend(_cleanup_prepared(prepared))
    if cleanup_failures:
        raise RenameError(
            _failure_message(
                RenameError("rename committed but cleanup was incomplete"),
                [],
                cleanup_failures,
            )
        )


def main(argv=None):
    args = sys.argv[1:] if argv is None else list(argv)
    if len(args) != 2:
        print("usage: project-rename <old-name> <new-name>", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("kilnr project rename: must run as root", file=sys.stderr)
        return 1
    try:
        old = _validated_name(args[0])
        new = _validated_name(args[1])
        if old == new:
            _fail("old and new project names must be different")
        provision_project_locks(DEFAULT_ROOTS.locks, [new])
        with project_locks(
            DEFAULT_ROOTS.locks, sorted((old, new)), exclusive=True
        ):
            inventory = inventory_rename(DEFAULT_ROOTS, old, new)
            prepared = prepare_rename(inventory)
            commit_rename(prepared)
    except (RenameError, ValueError, OSError) as exc:
        print(f"kilnr project rename: {exc}", file=sys.stderr)
        return 1
    server = socket.getfqdn() or "kilnr-server"
    print(f"Renamed Kilnr project: {old} -> {new}")
    print(f"Repository: {inventory.repository.destination}")
    print("Development machine:")
    print(
        "  git remote set-url home "
        f"git@{server}:{inventory.repository.destination}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
