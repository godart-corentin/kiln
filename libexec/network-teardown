#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="/etc/kilnr/network.env"

if [[ "${EUID}" -ne 0 ]]; then
    echo "kilnr network teardown: must run as root" >&2
    exit 1
fi

if [[ -f "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
else
    NETWORK="kilnr-ci"
    BRIDGE="kilnr0"
    SUBNET="172.30.0.0/24"
fi

while iptables -C DOCKER-USER -i "$BRIDGE" -j KILNR-CI-EGRESS 2>/dev/null; do
    iptables -D DOCKER-USER -i "$BRIDGE" -j KILNR-CI-EGRESS || true
done

while iptables -C INPUT -i "$BRIDGE" -s "$SUBNET" -j KILNR-CI-HOST 2>/dev/null; do
    iptables -D INPUT -i "$BRIDGE" -s "$SUBNET" -j KILNR-CI-HOST || true
done

iptables -F KILNR-CI-EGRESS 2>/dev/null || true
iptables -X KILNR-CI-EGRESS 2>/dev/null || true
iptables -F KILNR-CI-HOST 2>/dev/null || true
iptables -X KILNR-CI-HOST 2>/dev/null || true

docker network rm "$NETWORK" >/dev/null 2>&1 || true
echo "kilnr network: removed"
