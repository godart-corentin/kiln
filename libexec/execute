#!/usr/bin/env python3
import fcntl
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import threading
from datetime import datetime, timezone
from pathlib import Path

BUILDS = Path("/var/lib/kilnr/builds")
CACHE_ROOT = Path("/var/lib/kilnr/cache")
BUILD_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
JOB_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,62}$")
TOOL_VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$")

ARTIFACTS_MODULE_PATH = Path(__file__).resolve().with_name("artifacts.py")
_ARTIFACTS_SPEC = importlib.util.spec_from_file_location("kilnr_artifacts", ARTIFACTS_MODULE_PATH)
if _ARTIFACTS_SPEC is None or _ARTIFACTS_SPEC.loader is None:
    raise RuntimeError(f"cannot load artifacts module: {ARTIFACTS_MODULE_PATH}")
artifacts_schema = importlib.util.module_from_spec(_ARTIFACTS_SPEC)
_ARTIFACTS_SPEC.loader.exec_module(artifacts_schema)

SECRETS_ROOT = Path("/etc/kilnr/secrets")
SECRET_STAGING = Path("/var/lib/kilnr/secret-staging")
JOB_RUNTIME = Path("/var/lib/kilnr/job-runtime")
SECRETS_MODULE_PATH = Path(__file__).resolve().with_name("kilnr_secrets.py")
_SECRETS_SPEC = importlib.util.spec_from_file_location("kilnr_secrets", SECRETS_MODULE_PATH)
if _SECRETS_SPEC is None or _SECRETS_SPEC.loader is None:
    raise RuntimeError(f"cannot load secrets module: {SECRETS_MODULE_PATH}")
secret_schema = importlib.util.module_from_spec(_SECRETS_SPEC)
_SECRETS_SPEC.loader.exec_module(secret_schema)


class KilnrError(Exception):
    pass


def fail(message):
    raise KilnrError(message)


def iso(value=None):
    return (value or datetime.now(timezone.utc)).isoformat().replace("+00:00", "Z")


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"file not found: {path}")
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON {path}: {exc}")


def write_json(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with tmp.open("x", encoding="utf-8") as f:
            os.fchmod(f.fileno(), 0o640)
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        dir_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    finally:
        tmp.unlink(missing_ok=True)


def update_job(build_dir, job_id, changes):
    lock_path = build_dir / "status.lock"
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o640)
    try:
        os.fchmod(fd, 0o640)
        fcntl.flock(fd, fcntl.LOCK_EX)
        path = build_dir / "status.json"
        status = read_json(path)
        pipeline = status.get("pipeline")
        jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
        if job_id not in jobs:
            fail(f"job {job_id!r} missing from status")
        jobs[job_id].update(changes)
        write_json(path, status)
    finally:
        os.close(fd)


def render_run_script(commands):
    lines = ["#!/bin/sh", "set -eu"]
    for command in commands:
        lines.append(f"printf '%s\\n' {shlex.quote('$ ' + command)}")
        lines.append(command)
    lines.append("")
    return "\n".join(lines)


def prepare_execution(build_dir, job_id, job):
    modes = [mode for mode in ("run", "script", "command") if mode in job]
    if len(modes) != 1:
        fail(f"job {job_id!r} has invalid execution mode")

    mode = modes[0]
    if mode == "run":
        commands_dir = build_dir / "commands"
        commands_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
        script_path = commands_dir / f"{job_id}.sh"
        script_path.write_text(render_run_script(job["run"]), encoding="utf-8")
        script_path.chmod(0o600)
        mount = f"type=bind,src={script_path},dst=/run/kilnr/job.sh,readonly"
        return [mount], ["/bin/sh", "/run/kilnr/job.sh"]

    if mode == "script":
        return [], [f"/workspace/{job['script']}"]

    return [], list(job["command"])


def render_tools_wrapper(tools):
    if not tools:
        return "#!/bin/sh\nset -eu\nexec \"$@\"\n"

    lines = [
        "#!/bin/sh",
        "set -eu",
        'TOOLS_ROOT="/run/kilnr/tmp/tools"',
        'mkdir -p "$TOOLS_ROOT/corepack"',
        'export COREPACK_HOME="$TOOLS_ROOT/corepack"',
        'export COREPACK_DEFAULT_TO_LATEST=0',
        'export COREPACK_ENABLE_PROJECT_SPEC=0',
        'export PATH="/run/kilnr/tools/bin:$PATH"',
        'exec "$@"',
        "",
    ]

    return "\n".join(lines)


def prepare_tools_wrapper(build_dir, job_id, tools, execution_argv):
    if not tools:
        return [], list(execution_argv)

    commands_dir = build_dir / "commands"
    commands_dir.mkdir(mode=0o750, parents=True, exist_ok=True)

    tools_wrapper = commands_dir / f"{job_id}.tools.sh"
    tools_wrapper.write_text(
        render_tools_wrapper(tools),
        encoding="utf-8",
    )
    tools_wrapper.chmod(0o600)

    tools_root = build_dir / "runtime" / job_id / "tools"
    tools_bin = tools_root / "bin"
    tools_bin.mkdir(mode=0o750, parents=True, exist_ok=True)

    if "pnpm" in tools:
        version = tools["pnpm"]

        pnpm_wrapper = tools_bin / "pnpm"
        pnpm_wrapper.write_text(
            "#!/bin/sh\n"
            f"exec corepack {shlex.quote(f'pnpm@{version}')} \"$@\"\n",
            encoding="utf-8",
        )
        pnpm_wrapper.chmod(0o750)

    mounts = [
        (
            f"type=bind,src={tools_wrapper},"
            "dst=/run/kilnr/tools-wrapper.sh,readonly"
        ),
        (
            f"type=bind,src={tools_root},"
            "dst=/run/kilnr/tools,readonly"
        ),
    ]

    argv = [
        "/bin/sh",
        "/run/kilnr/tools-wrapper.sh",
        *execution_argv,
    ]

    return mounts, argv


def input_env_name(job_id):
    return "KILNR_INPUT_" + job_id.upper().replace("-", "_")


def build_input_mounts(input_roots):
    mounts = []
    for producer, root in input_roots.items():
        mounts.append(
            f"type=bind,src={root},dst=/run/kilnr/inputs/{producer},readonly"
        )
    return mounts


def prepare_cache_mounts(runtime, job):
    caches = job.get("cache", {})
    if not caches:
        return []
    if not isinstance(caches, dict):
        fail("invalid runtime cache configuration")

    project = runtime.get("project")
    if not isinstance(project, str) or not JOB_RE.fullmatch(project):
        fail("invalid runtime project for cache")
    job_type = runtime.get("job_type")
    if job_type not in ("ci", "release"):
        fail("invalid runtime job type for cache")

    mounts = []
    for name, version in caches.items():
        if name != "pnpm":
            fail(f"unsupported runtime cache {name!r}")
        if not isinstance(version, str) or not TOOL_VERSION_RE.fullmatch(version):
            fail(f"invalid runtime cache version for {name!r}")
        root = CACHE_ROOT / project / job_type / name / version
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
        root.chmod(0o700)
        mounts.append(f"type=bind,src={root},dst=/run/kilnr/cache/{name}")
    return mounts


def build_public_env(runtime, job_id, job, input_roots):
    env = {
        "CI": "true",
        "HOME": "/run/kilnr/home",
        "KILNR_BUILD_ID": runtime["build_id"],
        "KILNR_PROJECT": runtime["project"],
        "KILNR_SHA": runtime["sha"],
        "KILNR_REF": runtime["ref"],
        "KILNR_JOB_TYPE": runtime["job_type"],
        "KILNR_JOB": job_id,
    }
    branch = runtime.get("branch")
    tag = runtime.get("tag")
    if branch:
        env["KILNR_BRANCH"] = branch
    if tag:
        env["KILNR_TAG"] = tag
    env.update(job.get("env", {}))
    if "pnpm" in job.get("cache", {}):
        env["PNPM_CONFIG_STORE_DIR"] = "/run/kilnr/cache/pnpm"
    env.setdefault("XDG_RUNTIME_DIR", "/run/kilnr/tmp")
    env.setdefault("TMPDIR", "/run/kilnr/tmp")
    env.setdefault("TMP", "/run/kilnr/tmp")
    env.setdefault("TEMP", "/run/kilnr/tmp")
    aliases = set()
    for producer in input_roots:
        key = input_env_name(producer)
        if key in aliases:
            fail(f"input environment alias collision for {producer!r}")
        aliases.add(key)
        env[key] = f"/run/kilnr/inputs/{producer}"
    return env


def prepare_job_home(build_id, job_id):
    job_root = JOB_RUNTIME / build_id / job_id
    shutil.rmtree(job_root, ignore_errors=True)

    home = job_root / "home"
    home.mkdir(mode=0o700, parents=True, exist_ok=False)
    home.chmod(0o700)

    return home, f"type=bind,src={home},dst=/run/kilnr/home"


def cleanup_job_runtime(build_id, job_id):
    build_root = JOB_RUNTIME / build_id
    shutil.rmtree(build_root / job_id, ignore_errors=True)

    try:
        build_root.rmdir()
    except (FileNotFoundError, OSError):
        pass


def collect_job_artifacts(build_dir, work_dir, job_id, job):
    patterns = job.get("artifacts", [])
    if not patterns:
        return []
    dest = build_dir / "artifacts" / job_id
    try:
        return artifacts_schema.collect_artifacts(work_dir, patterns, dest)
    except artifacts_schema.ArtifactError as exc:
        fail(str(exc))


def render_secret_wrapper(metadata):
    lines = ["#!/bin/sh", "set -eu"]
    for name, item in metadata.items():
        path = f"/run/kilnr/secrets/{name}.value"
        if item["kind"] == "text":
            lines.append(f'export {name}="$(cat {path})"')
        elif item["kind"] == "file":
            lines.append(f'export {name}="{path}"')
        else:
            fail(f"secret {name!r} has invalid kind")
    lines.append('exec "$@"')
    lines.append("")
    return "\n".join(lines)


def redaction_tokens(values):
    tokens = set()
    for value in values:
        if not value:
            continue
        tokens.add(value)
        for line in value.splitlines():
            if line:
                tokens.add(line)
    return sorted(tokens, key=len, reverse=True)


def redact_text(text, tokens):
    for token in tokens:
        text = text.replace(token, "***")
    return text


def prepare_secret_stage(build_id, job_id, runtime, job):
    names = job.get("secrets", [])
    if not names:
        return None, {}, []
    try:
        metadata = secret_schema.validate_requested_secrets(
            SECRETS_ROOT,
            runtime["project"],
            names,
            runtime["job_type"],
        )
    except secret_schema.SecretError as exc:
        fail(str(exc))

    stage = SECRET_STAGING / build_id / job_id
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(mode=0o700, parents=True)
    stage.chmod(0o700)

    redact_values = []
    for name in names:
        try:
            data = secret_schema.read_secret_bytes(SECRETS_ROOT, runtime["project"], name)
        except secret_schema.SecretError as exc:
            fail(str(exc))
        target = stage / f"{name}.value"
        target.write_bytes(data)
        target.chmod(0o400)
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            pass
        else:
            if text:
                redact_values.append(text)

    return stage, metadata, redact_values


def prepare_secret_wrapper(build_dir, job_id, metadata):
    if not metadata:
        return None
    commands_dir = build_dir / "commands"
    commands_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
    wrapper = commands_dir / f"{job_id}.secrets.sh"
    wrapper.write_text(render_secret_wrapper(metadata), encoding="utf-8")
    wrapper.chmod(0o600)
    return wrapper


def cleanup_secret_stage(build_id, job_id):
    stage = SECRET_STAGING / build_id / job_id
    shutil.rmtree(stage, ignore_errors=True)
    parent = stage.parent
    try:
        parent.rmdir()
    except OSError:
        pass


def stream_redacted_output(process, log, tokens):
    assert process.stdout is not None
    for line in process.stdout:
        log.write(redact_text(line, tokens))
        log.flush()


def prepare_workspace(src_dir, work_dir, log):
    if work_dir.exists():
        shutil.rmtree(work_dir)
    work_dir.mkdir(mode=0o750, parents=True)

    log.write("Preparing isolated workspace...\n")
    log.flush()

    archive = subprocess.Popen(
        [
            "/usr/bin/tar", "--create", "--file=-",
            "--directory", str(src_dir), ".",
        ],
        stdout=subprocess.PIPE,
        stderr=log,
    )
    extract = subprocess.Popen(
        [
            "/usr/bin/tar", "--extract", "--file=-",
            "--directory", str(work_dir),
            "--no-same-owner", "--no-same-permissions",
        ],
        stdin=archive.stdout,
        stdout=log,
        stderr=log,
    )
    assert archive.stdout is not None
    archive.stdout.close()

    extract_rc = extract.wait()
    archive_rc = archive.wait()
    if archive_rc != 0:
        fail(f"workspace archive failed with exit code {archive_rc}")
    if extract_rc != 0:
        fail(f"workspace extraction failed with exit code {extract_rc}")

    log.write("Workspace prepared successfully.\n")
    log.flush()


def container_name(build_id, job_id):
    return f"kilnr-{build_id[-32:]}-{job_id}"[:120]


def main():
    if len(sys.argv) != 3:
        print("usage: execute <build-id> <job-id>", file=sys.stderr)
        return 2

    build_id, job_id = sys.argv[1:]
    if not BUILD_RE.fullmatch(build_id):
        fail("invalid build id")
    if not JOB_RE.fullmatch(job_id):
        fail("invalid job id")

    build_dir = BUILDS / build_id
    runtime = read_json(build_dir / "runtime.json")
    if runtime.get("build_id") != build_id:
        fail("runtime build id mismatch")
    jobs = runtime.get("jobs")
    if not isinstance(jobs, dict):
        fail("invalid runtime jobs")
    if job_id not in jobs:
        fail(f"unknown job: {job_id}")

    job = jobs[job_id]

    src_dir = build_dir / "src"
    work_dir = build_dir / "work" / job_id
    log_path = build_dir / "logs" / f"{job_id}.log"

    started = datetime.now(timezone.utc)
    update_job(
        build_dir,
        job_id,
        {
            "state": "running",
            "started_at": iso(started),
            "finished_at": None,
            "duration_seconds": None,
            "exit_code": None,
        },
    )

    uid = os.geteuid()
    gid = os.getegid()
    runner = runtime["runner"]
    name = container_name(build_id, job_id)
    rc = 1
    error = None
    input_roots = None
    collected = []
    secret_stage = None
    secret_metadata = {}
    redact_values = []

    with log_path.open("w", encoding="utf-8") as log:
        log.write(
            f"build: {build_id}\n"
            f"job: {job_id}\n"
            f"image: {job['image']}\n"
            f"network: {job['network']}\n"
            f"tools: {', '.join(f'{name}={version}' for name, version in job.get('tools', {}).items()) or 'none'}\n"
            f"cache: {', '.join(f'{name}={version}' for name, version in job.get('cache', {}).items()) or 'none'}\n"
            f"limits: cpus={runner['cpus']} memory={runner['memory']} "
            f"pids={runner['pids_limit']} timeout={runner['timeout_seconds']}s\n\n"
        )
        log.flush()

        try:
            prepare_workspace(src_dir, work_dir, log)
        except Exception as exc:
            error = str(exc)
            log.write(f"\nKILNR ERROR: {error}\n")
            rc = 1
        else:
            try:
                input_roots = artifacts_schema.resolve_input_roots(
                    build_dir, job.get("resolved_inputs", [])
                )
            except artifacts_schema.ArtifactError as exc:
                error = str(exc)
                log.write(f"\nKILNR ERROR: {error}\n")
                rc = 1
                input_roots = None

        if error is None and input_roots is not None:
            try:
                secret_stage, secret_metadata, redact_values = prepare_secret_stage(
                    build_id, job_id, runtime, job
                )
            except Exception as exc:
                error = str(exc)
                log.write(f"\nKILNR ERROR: {error}\n")
                rc = 1

        if error is None and input_roots is not None:
            extra_mounts, execution_argv = prepare_execution(build_dir, job_id, job)
            extra_mounts.extend(build_input_mounts(input_roots))
            extra_mounts.extend(prepare_cache_mounts(runtime, job))
            if secret_stage is not None:
                extra_mounts.append(
                    f"type=bind,src={secret_stage},dst=/run/kilnr/secrets,readonly"
                )
                wrapper = prepare_secret_wrapper(build_dir, job_id, secret_metadata)
                extra_mounts.append(
                    f"type=bind,src={wrapper},dst=/run/kilnr/secret-wrapper.sh,readonly"
                )
                execution_argv = [
                    "/bin/sh", "/run/kilnr/secret-wrapper.sh", *execution_argv
                ]
            tools_mounts, execution_argv = prepare_tools_wrapper(
                build_dir,
                job_id,
                job.get("tools", {}),
                execution_argv,
            )

            extra_mounts.extend(tools_mounts)
            public_env = build_public_env(runtime, job_id, job, input_roots)
            _host_home, home_mount = prepare_job_home(
                build_id,
                job_id,
            )
            extra_mounts.append(home_mount)

            docker_command = [
                "/usr/bin/docker", "run",
                "--rm",
                "--name", name,
                "--init",
                "--pull=missing",
                "--network", job["network"],
                "--cpus", runner["cpus"],
                "--memory", runner["memory"],
                "--pids-limit", str(runner["pids_limit"]),
                "--cap-drop", "ALL",
                "--security-opt", "no-new-privileges=true",
                "--user", f"{uid}:{gid}",
                "--workdir", "/workspace",
                "--tmpfs", "/tmp:rw,nosuid,nodev,noexec,size=512m",
                "--tmpfs", f"/run/kilnr/tmp:rw,nosuid,nodev,exec,size=512m,uid={uid},gid={gid},mode=700",
                "--mount", f"type=bind,src={work_dir},dst=/workspace",
                "--label", f"kilnr.build_id={build_id}",
                "--label", f"kilnr.job={job_id}",
            ]
            for key, value in public_env.items():
                docker_command.extend(["--env", f"{key}={value}"])
            for mount in extra_mounts:
                docker_command.extend(["--mount", mount])
            docker_command.extend([job["image"], *execution_argv])

            process = subprocess.Popen(
                docker_command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
                bufsize=1,
            )
            tokens = redaction_tokens(redact_values)
            reader = threading.Thread(
                target=stream_redacted_output,
                args=(process, log, tokens),
                daemon=True,
            )
            reader.start()
            try:
                rc = process.wait(timeout=runner["timeout_seconds"])
            except subprocess.TimeoutExpired:
                error = f"timeout after {runner['timeout_seconds']} seconds"
                subprocess.run(
                    ["/usr/bin/docker", "rm", "-f", name],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                try:
                    process.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
                rc = 124
                log.write(f"\nKILNR ERROR: {error}\n")
            finally:
                reader.join(timeout=15)

            if rc == 0:
                try:
                    collected = collect_job_artifacts(build_dir, work_dir, job_id, job)
                except Exception as exc:
                    error = str(exc)
                    rc = 1
                    collected = []
                    log.write(f"\nKILNR ERROR: artifact collection failed: {error}\n")
                else:
                    if collected:
                        log.write("\nCollected artifacts:\n")
                        for path in collected:
                            log.write(f"  {path}\n")
            else:
                collected = []

    cleanup_secret_stage(build_id, job_id)
    cleanup_job_runtime(build_id, job_id)
    finished = datetime.now(timezone.utc)
    duration = round((finished - started).total_seconds(), 3)
    state = "success" if rc == 0 else "failed"
    changes = {
        "state": state,
        "exit_code": rc,
        "finished_at": iso(finished),
        "duration_seconds": duration,
        "artifacts": collected,
    }
    if error:
        changes["error"] = error
    update_job(build_dir, job_id, changes)

    print(f"{job_id}: {state} ({duration:.3f}s)")
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KilnrError as exc:
        print(f"kilnr execute: {exc}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:
        print(f"kilnr execute: unexpected error: {exc}", file=sys.stderr)
        sys.exit(1)
