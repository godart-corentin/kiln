#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

from kilnr_project_lock import (
    project_locks,
    provision_project_locks,
    validate_project_name,
)


PROJECT_LOCK_ROOT = Path("/var/lib/kilnr/locks/projects")


def fail(message: str, *, status: int = 1) -> int:
    print(f"kilnr project lock: {message}", file=sys.stderr)
    return status


def main() -> int:
    if os.geteuid() != 0:
        return fail("must run as root")

    args = sys.argv[1:]
    if len(args) < 4 or args[0] != "--exclusive" or args[2] != "--":
        return fail(
            "usage: project-lock-run --exclusive <project> -- <program> [args...]",
            status=2,
        )

    project = args[1]
    try:
        validate_project_name(project)
    except ValueError as exc:
        return fail(str(exc))

    provision_project_locks(PROJECT_LOCK_ROOT, [project])
    with project_locks(PROJECT_LOCK_ROOT, [project], exclusive=True):
        result = subprocess.run(args[3:], check=False)
    return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except OSError as exc:
        print(f"kilnr project lock: {exc}", file=sys.stderr)
        raise SystemExit(1)
