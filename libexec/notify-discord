#!/usr/bin/env python3
import json
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import quote

BUILDS = Path("/var/lib/kilnr/builds")
CONFIG_ROOT = Path("/etc/kilnr/projects")
WEB_CONFIG = Path("/etc/kilnr/web.json")

ANSI_RE = re.compile(
    r"\x1B(?:\[[0-?]*[ -/]*[@-~]|\].*?(?:\x07|\x1B\\))",
    re.DOTALL,
)
CONTROL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
ERROR_SIGNAL_RE = re.compile(
    r"AssertionError|TypeError|ReferenceError|SyntaxError|Error:|FAIL\b|"
    r"Expected:|Received:|\bexpected\b|\breceived\b|ERR_[A-Z0-9_]+|[✗✖×]",
    re.IGNORECASE,
)
SUMMARY_RE = re.compile(
    r"^\s*(?:Test\s+Files|Tests|Errors|Start\s+at|Duration)\b",
    re.IGNORECASE,
)


def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def sanitize(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = ANSI_RE.sub("", text)
    text = CONTROL_RE.sub("", text)
    return text.replace("```", "'''") 


def read_log_tail(path, max_bytes=128 * 1024):
    with path.open("rb") as f:
        f.seek(0, 2)
        size = f.tell()
        start = max(0, size - max_bytes)
        f.seek(start)
        data = f.read()
    if start > 0:
        parts = data.split(b"\n", 1)
        if len(parts) == 2:
            data = parts[1]
    return data.decode("utf-8", errors="replace")


def shorten(text, limit=900):
    if len(text) <= limit:
        return text
    head = 600
    tail = limit - head - 5
    return text[:head] + "\n…\n" + text[-tail:]


def error_excerpt(build_dir, status):
    failed = None
    pipeline = status.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    for job_id, job in reversed(list(jobs.items())):
        if job.get("state") == "failed":
            failed = (job_id, job)
            break
    if failed is None:
        prepare = status.get("prepare")
        if isinstance(prepare, dict) and prepare.get("state") == "failed":
            failed = ("prepare", prepare)
    if failed is None:
        return None, None

    job_id, job = failed
    log_path = build_dir / job.get("log", "")
    if not log_path.is_file():
        error = job.get("error")
        return job_id, sanitize(str(error)) if error else "Job failed."

    text = sanitize(read_log_tail(log_path))
    lines = [line.rstrip() for line in text.splitlines() if line.strip()]
    if not lines:
        return job_id, "Job failed with an empty log."

    error_index = None
    for index in range(len(lines) - 1, -1, -1):
        line = lines[index]
        if SUMMARY_RE.search(line):
            continue
        if ERROR_SIGNAL_RE.search(line):
            error_index = index
            break

    if error_index is None:
        selected = lines[-16:]
    else:
        start = max(0, error_index - 4)
        end = min(len(lines), error_index + 12)
        selected = lines[start:end]

    return job_id, shorten("\n".join(selected))


def short_ref(ref):
    for prefix in ("refs/heads/", "refs/tags/"):
        if ref.startswith(prefix):
            return ref[len(prefix):]
    return ref


def duration(value):
    if not isinstance(value, (int, float)):
        return "n/a"
    seconds = int(round(value))
    minutes, seconds = divmod(seconds, 60)
    return f"{minutes}m{seconds:02d}s" if minutes else f"{seconds}s"


def group_title(group):
    return group.replace("_", " ").replace("-", " ").title()


def build_url(build_id):
    if not WEB_CONFIG.is_file():
        return None
    try:
        config = read_json(WEB_CONFIG)
        public_url = config.get("public_url")
        if not isinstance(public_url, str) or not public_url.startswith("https://"):
            return None
        return public_url.rstrip("/") + "/build/" + quote(build_id, safe="")
    except Exception:
        return None


def render_message(build_dir, status):
    state = status.get("state", "failed")
    success = state == "success"
    icon = "✅" if success else "❌"
    kind = "release" if status.get("type") == "release" else "build"
    adjective = "successful" if success else state

    lines = [
        f"{icon} **{status['project']} — {kind} {adjective}**",
        "",
        f"{short_ref(status['ref'])} · `{status['sha'][:7]}`",
        "",
    ]

    groups = {}
    pipeline = status.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    for job_id, job in jobs.items():
        group = job.get("group") or "other"
        groups.setdefault(group, []).append((job_id, job))

    icons = {
        "success": "✅",
        "failed": "❌",
        "skipped": "⏭️",
        "running": "🔄",
        "pending": "⏳",
        "aborted": "🛑",
    }
    for group, grouped_jobs in groups.items():
        lines.append(f"**{group_title(group)}**")
        for job_id, job in grouped_jobs:
            job_state = job.get("state", "unknown")
            lines.append(f"{icons.get(job_state, '•')} {job_id}")
        lines.append("")

    lines.append("Duration: " + duration(status.get("duration_seconds")))

    url = build_url(status["build_id"])
    if url:
        lines.extend(["", f"🔗 {url}"])

    if not success:
        job_id, excerpt = error_excerpt(build_dir, status)
        if excerpt:
            lines.extend([
                "",
                f"**Last error — {job_id}**",
                "```text",
                excerpt,
                "```",
            ])

    content = "\n".join(lines)
    if len(content) > 1900:
        content = content[:1880] + "\n…"
    return content


def main():
    render_only = False
    if len(sys.argv) == 3 and sys.argv[1] == "--render":
        render_only = True
        build_id = sys.argv[2]
    elif len(sys.argv) == 2:
        build_id = sys.argv[1]
    else:
        print(
            "usage:\n  notify-discord <build-id>\n  notify-discord --render <build-id>",
            file=sys.stderr,
        )
        return 2

    build_dir = BUILDS / build_id
    status = read_json(build_dir / "status.json")
    content = render_message(build_dir, status)

    if render_only:
        print(content)
        return 0

    project_config = read_json(CONFIG_ROOT / f"{status['project']}.json")
    webhook_file = project_config.get("discord", {}).get("webhook_file")
    if not webhook_file:
        print("kilnr notify: Discord not configured")
        return 0

    webhook_path = Path(webhook_file)
    if not webhook_path.is_file():
        print("kilnr notify: Discord not configured")
        return 0

    webhook = webhook_path.read_text(encoding="utf-8").strip()
    if not webhook:
        print("kilnr notify: Discord not configured")
        return 0

    body = json.dumps({"content": content}).encode("utf-8")
    request = urllib.request.Request(
        webhook,
        data=body,
        headers={"Content-Type": "application/json", "User-Agent": "Kilnr-CI/1"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            if response.status not in (200, 204):
                print(f"kilnr notify: HTTP {response.status}", file=sys.stderr)
                return 1
    except (urllib.error.URLError, TimeoutError) as exc:
        print(f"kilnr notify: request failed: {exc}", file=sys.stderr)
        return 1

    print("kilnr notify: notification sent")
    return 0


if __name__ == "__main__":
    sys.exit(main())
