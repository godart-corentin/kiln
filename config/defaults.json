{
  "schema": 1,
  "runner": {
    "max_parallel": 3,
    "cpus": "0.75",
    "memory": "768m",
    "pids_limit": 256,
    "timeout_seconds": 1800,
    "allowed_networks": [
      "none",
      "kilnr-ci"
    ]
  },
  "retention": {
    "max_age_days": 30,
    "max_builds_per_ref": 10,
    "keep_releases": true
  }
}
