{
  "schema": 1,
  "trigger": {
    "type": "branch",
    "branches": [
      "feature/*"
    ]
  },
  "max_parallel": 2,
  "jobs": {
    "tests": {
      "group": "quality",
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "corepack pnpm@11.15.1 install --frozen-lockfile",
        "pnpm test"
      ]
    }
  }
}
