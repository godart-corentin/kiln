{
  "schema": 1,
  "trigger": {
    "type": "branch",
    "branches": [
      "feature/*"
    ]
  },
  "max_parallel": 2,
  "jobs": {
    "tests": {
      "group": "quality",
      "image": "node:24-bookworm",
      "network": "kilnr-ci",
      "run": [
        "pnpm install --frozen-lockfile",
        "pnpm test"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    }
  }
}
