{
  "schema": 1,
  "trigger": {
    "type": "branch",
    "branches": [
      "main"
    ]
  },
  "max_parallel": 3,
  "jobs": {
    "lint": {
      "group": "quality",
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "corepack pnpm@11.15.1 install --frozen-lockfile",
        "pnpm lint"
      ]
    },
    "tests": {
      "group": "quality",
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "corepack pnpm@11.15.1 install --frozen-lockfile",
        "pnpm test"
      ]
    },
    "build": {
      "group": "build-group",
      "needs": [
        "quality"
      ],
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "corepack pnpm@11.15.1 install --frozen-lockfile",
        "pnpm build"
      ]
    }
  }
}
