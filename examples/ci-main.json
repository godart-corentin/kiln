{
  "schema": 1,
  "trigger": {
    "type": "branch",
    "branches": [
      "main"
    ]
  },
  "max_parallel": 3,
  "jobs": {
    "lint": {
      "group": "quality",
      "image": "node:24-bookworm",
      "network": "kilnr-ci",
      "run": [
        "pnpm install --frozen-lockfile",
        "pnpm lint"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    },
    "tests": {
      "group": "quality",
      "image": "node:24-bookworm",
      "network": "kilnr-ci",
      "run": [
        "pnpm install --frozen-lockfile",
        "pnpm test"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    },
    "build": {
      "group": "build-group",
      "needs": [
        "quality"
      ],
      "image": "node:24-bookworm",
      "network": "kilnr-ci",
      "run": [
        "pnpm install --frozen-lockfile",
        "pnpm build"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    }
  }
}
