{
  "schema": 1,
  "max_parallel": 2,
  "jobs": {
    "validate": {
      "group": "quality",
      "image": "node:24-bookworm",
      "network": "kiln-ci",
      "run": [
        "pnpm install --frozen-lockfile",
        "pnpm test"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    },
    "package-linux": {
      "group": "package",
      "needs": [
        "quality"
      ],
      "image": "node:24-bookworm",
      "network": "kiln-ci",
      "run": [
        "pnpm dist -- --linux"
      ],
      "tools": {
        "pnpm": "11.15.1"
      }
    }
  }
}
