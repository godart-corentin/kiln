{
  "schema": 1,
  "max_parallel": 2,
  "jobs": {
    "validate": {
      "group": "quality",
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "corepack pnpm@11.15.1 install --frozen-lockfile",
        "pnpm test"
      ]
    },
    "package-linux": {
      "group": "package",
      "needs": [
        "quality"
      ],
      "image": "node:22-bookworm",
      "network": "kiln-ci",
      "run": [
        "pnpm dist -- --linux"
      ]
    }
  }
}
