#!/usr/bin/env python3
import getpass
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

BUILDS = Path("/var/lib/kilnr/builds")
PROJECT_CREATE = "/usr/local/libexec/kilnr/project-create"
PROJECT_DELETE = "/usr/local/libexec/kilnr/project-delete"
PROJECT_WEBHOOK_SET = "/usr/local/libexec/kilnr/project-webhook-set"
RERUN = "/usr/local/libexec/kilnr/rerun"
GIT_KEY_ADD = "/usr/local/libexec/kilnr/git-key-add"
DOCTOR = "/usr/local/libexec/kilnr/doctor"
SECRET_SET = "/usr/local/libexec/kilnr/secret-set"
SECRET_SET_FILE = "/usr/local/libexec/kilnr/secret-set-file"
SECRET_LIST = "/usr/local/libexec/kilnr/secret-list"
SECRET_DELETE = "/usr/local/libexec/kilnr/secret-delete"

LOG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
FINAL_BUILD_STATES = {"success", "failed", "aborted"}
FINAL_STEP_STATES = {"success", "failed", "skipped", "aborted"}


def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def all_builds():
    try:
        items = [p for p in BUILDS.iterdir() if p.is_dir()]
    except FileNotFoundError:
        return []
    return sorted(items, key=lambda p: p.name, reverse=True)


def resolve_build(query):
    candidates = all_builds()
    if not candidates:
        raise RuntimeError("no builds found")
    if query == "latest":
        return candidates[0]
    exact = BUILDS / query
    if exact.is_dir():
        return exact

    matches = []
    for build in candidates:
        try:
            status = read_json(build / "status.json")
        except Exception:
            continue
        sha = str(status.get("sha", ""))
        if build.name.startswith(query) or sha.startswith(query):
            matches.append(build)
    if not matches:
        raise RuntimeError(f"no build matches {query!r}")
    return matches[0]


def short_ref(ref):
    for prefix in ("refs/heads/", "refs/tags/"):
        if ref.startswith(prefix):
            return ref[len(prefix):]
    return ref


def fmt_duration(value):
    if not isinstance(value, (int, float)):
        return "-"
    seconds = int(round(value))
    minutes, seconds = divmod(seconds, 60)
    return f"{minutes}m{seconds:02d}s" if minutes else f"{seconds}s"


def show_status(build):
    data = read_json(build / "status.json")
    print(f"Build:    {data['build_id']}")
    print(f"Project:  {data['project']}")
    print(f"Ref:      {short_ref(data['ref'])}")
    print(f"SHA:      {data['sha']}")
    print(f"Type:     {data['type']}")
    print(f"State:    {data['state']}")
    print("Duration: " + fmt_duration(data.get("duration_seconds")))
    print()

    symbols = {
        "success": "OK",
        "failed": "FAIL",
        "skipped": "SKIP",
        "running": "RUN",
        "pending": "WAIT",
        "aborted": "ABRT",
    }
    prepare = data.get("prepare")
    if isinstance(prepare, dict):
        marker = symbols.get(prepare.get("state"), str(prepare.get("state", "?")).upper())
        extra = ""
        if prepare.get("duration_seconds") is not None:
            extra = f" ({fmt_duration(prepare['duration_seconds'])})"
        print(f"{marker:4}  {'internal':12} prepare{extra}")

    pipeline = data.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    for job_id, job in jobs.items():
        marker = symbols.get(job.get("state"), str(job.get("state", "?")).upper())
        extra = ""
        if job.get("duration_seconds") is not None:
            extra = f" ({fmt_duration(job['duration_seconds'])})"
        group = job.get("group") or "-"
        print(f"{marker:4}  {group:12} {job_id}{extra}")


def show_logs(build, step=None):
    logs_dir = build / "logs"
    if step is not None:
        if not LOG_RE.fullmatch(step):
            raise RuntimeError("invalid log name")
        path = logs_dir / f"{step}.log"
        if not path.is_file():
            raise RuntimeError(f"log not found: {step}")
        sys.stdout.write(path.read_text(encoding="utf-8", errors="replace"))
        return

    paths = sorted(logs_dir.glob("*.log"))
    if not paths:
        raise RuntimeError("no logs found")
    for index, path in enumerate(paths):
        if index:
            print()
        print(f"===== {path.name} =====")
        content = path.read_text(encoding="utf-8", errors="replace")
        sys.stdout.write(content)
        if content and not content.endswith("\n"):
            print()


def terminal_state(build, target):
    status_path = build / "status.json"
    if not status_path.is_file():
        return None
    try:
        status = read_json(status_path)
    except Exception:
        return None

    if target == "pipeline":
        state = status.get("state")
        return state if state in FINAL_BUILD_STATES else None

    pipeline = status.get("pipeline")
    jobs = pipeline.get("jobs", {}) if isinstance(pipeline, dict) else {}
    job = jobs.get(target)
    if job is None:
        raise RuntimeError(f"unknown job: {target}")
    state = job.get("state")
    return state if state in FINAL_STEP_STATES else None


def watch_log(build, target):
    if not LOG_RE.fullmatch(target):
        raise RuntimeError("invalid log name")
    log_path = build / "logs" / f"{target}.log"
    print(f"Watching {build.name} / {target} (Ctrl+C to stop)", file=sys.stderr)

    handle = None
    inode = None
    try:
        while True:
            if handle is None:
                try:
                    handle = log_path.open("r", encoding="utf-8", errors="replace")
                    inode = os.fstat(handle.fileno()).st_ino
                except FileNotFoundError:
                    state = terminal_state(build, target)
                    if state is not None:
                        print(f"kilnr: {target}: {state}", file=sys.stderr)
                        return 0 if state == "success" else 1
                    time.sleep(0.25)
                    continue

            chunk = handle.read()
            if chunk:
                sys.stdout.write(chunk)
                sys.stdout.flush()
                continue

            try:
                current_inode = log_path.stat().st_ino
            except FileNotFoundError:
                current_inode = None
            if current_inode is not None and current_inode != inode:
                handle.close()
                handle = None
                inode = None
                continue

            state = terminal_state(build, target)
            if state is not None:
                time.sleep(0.1)
                chunk = handle.read()
                if chunk:
                    sys.stdout.write(chunk)
                    sys.stdout.flush()
                print(f"\nkilnr: {target}: {state}", file=sys.stderr)
                return 0 if state == "success" else 1
            time.sleep(0.25)
    finally:
        if handle is not None:
            handle.close()


def privileged_command(helper, *args, stdin_text=None):
    command = [helper, *args] if os.geteuid() == 0 else ["/usr/bin/sudo", helper, *args]
    return subprocess.run(command, input=stdin_text, text=True, check=False).returncode


def project_delete(project):
    print(
        f"This will permanently delete the Git repository and Kilnr configuration for '{project}'."
    )
    print("Existing build history, logs and artifacts will be preserved.")
    confirmation = input(f"Type '{project}' to confirm: ").strip()
    if confirmation != project:
        print("kilnr: deletion cancelled", file=sys.stderr)
        return 1
    return privileged_command(PROJECT_DELETE, project)


def project_webhook_set(project):
    webhook = getpass.getpass("Discord webhook URL: ").strip()
    if not webhook:
        print("kilnr: webhook cannot be empty", file=sys.stderr)
        return 1
    return privileged_command(PROJECT_WEBHOOK_SET, project, stdin_text=webhook + "\n")


def rerun_build(query):
    build = resolve_build(query)
    status = read_json(build / "status.json")
    if status.get("type") != "ci":
        raise RuntimeError("release builds cannot be rerun")
    print(f"Rerunning {build.name}")
    print(f"SHA: {status['sha']}")
    return privileged_command(RERUN, build.name)


def git_key_add():
    print("Paste one Ed25519 SSH public key:")
    key = input().strip()
    if not key:
        print("kilnr: key cannot be empty", file=sys.stderr)
        return 1
    return privileged_command(GIT_KEY_ADD, stdin_text=key + "\n")


def doctor():
    return privileged_command(
        DOCTOR
    )


def secret_set(project, name):
    value = getpass.getpass("Secret value: ")
    if not value:
        print("kilnr: secret cannot be empty", file=sys.stderr)
        return 1
    return privileged_command(SECRET_SET, project, name, stdin_text=value)


def secret_set_file(project, name, path):
    source = Path(path).expanduser().resolve()
    if not source.is_file():
        print(f"kilnr: secret file not found: {source}", file=sys.stderr)
        return 1
    return privileged_command(SECRET_SET_FILE, project, name, str(source))


def secret_list(project):
    return privileged_command(SECRET_LIST, project)


def secret_delete(project, name):
    return privileged_command(SECRET_DELETE, project, name)


def usage():
    print(
        """Usage:
  kilnr status <latest|build-id|sha-prefix>
  kilnr logs <latest|build-id|sha-prefix> [job]
  kilnr watch <latest|build-id|sha-prefix> <job|pipeline>
  kilnr rerun <latest|build-id|sha-prefix>
  kilnr doctor

  kilnr project create <project-name>
  kilnr project delete <project-name>
  kilnr project webhook set <project-name>

  kilnr secret set <project> <name>
  kilnr secret set-file <project> <name> <path>
  kilnr secret list <project>
  kilnr secret delete <project> <name>

  kilnr git-key add
""",
        file=sys.stderr,
    )
    return 2


def main():
    args = sys.argv[1:]

    if len(args) == 3 and args[:2] == ["project", "create"]:
        return privileged_command(PROJECT_CREATE, args[2])
    if len(args) == 3 and args[:2] == ["project", "delete"]:
        return project_delete(args[2])
    if len(args) == 4 and args[:3] == ["project", "webhook", "set"]:
        return project_webhook_set(args[3])
    if len(args) == 4 and args[:2] == ["secret", "set"]:
        return secret_set(args[2], args[3])
    if len(args) == 5 and args[:2] == ["secret", "set-file"]:
        return secret_set_file(args[2], args[3], args[4])
    if len(args) == 3 and args[:2] == ["secret", "list"]:
        return secret_list(args[2])
    if len(args) == 4 and args[:2] == ["secret", "delete"]:
        return secret_delete(args[2], args[3])
    if len(args) == 2 and args == ["git-key", "add"]:
        return git_key_add()
    if len(args) == 1 and args[0] == "doctor":
        return doctor()

    if len(args) == 2 and args[0] == "status":
        show_status(resolve_build(args[1]))
        return 0
    if len(args) in (2, 3) and args[0] == "logs":
        show_logs(resolve_build(args[1]), args[2] if len(args) == 3 else None)
        return 0
    if len(args) == 3 and args[0] == "watch":
        return watch_log(resolve_build(args[1]), args[2])
    if len(args) == 2 and args[0] == "rerun":
        return rerun_build(args[1])
    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except PermissionError:
        print("kilnr: permission denied; check kilnr-readers membership", file=sys.stderr)
        sys.exit(1)
    except RuntimeError as exc:
        print(f"kilnr: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nkilnr: stopped", file=sys.stderr)
        sys.exit(130)
